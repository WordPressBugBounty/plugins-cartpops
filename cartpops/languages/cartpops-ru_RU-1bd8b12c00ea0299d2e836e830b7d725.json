f\u0440\u043e\u0434\u0430\u0436\u0438"],"Cart Expiry Timer":["\u0422\u0430\u0439\u043c\u0435\u0440 \u0441\u0440\u043e\u043a\u0430 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f \u043a\u043e\u0440\u0437\u0438\u043d\u044b"],"Custom Message":["\u041f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u043e\u0435 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0435"],"Product Spotlight":["\u0410\u043a\u0446\u0435\u043d\u0442 \u043d\u0430 \u0442\u043e\u0432\u0430\u0440\u0435"],"Info":["\u0418\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f"],"Gift":["\u041f\u043e\u0434\u0430\u0440\u043e\u043a"],"Truck":["\u0413\u0440\u0443\u0437\u043e\u0432\u0438\u043a"],"Tag":["\u042f\u0440\u043b\u044b\u043a"],"Star":["\u0417\u0432\u0435\u0437\u0434\u0430"],"Clock":["\u0427\u0430\u0441\u044b"],"Clear Cart":["\u041e\u0447\u0438\u0441\u0442\u0438\u0442\u044c \u043a\u043e\u0440\u0437\u0438\u043d\u0443"],"Redirect to Shop":["\u041f\u0435\u0440\u0435\u043d\u0430\u043f\u0440\u0430\u0432\u0438\u0442\u044c \u0432 \u043c\u0430\u0433\u0430\u0437\u0438\u043d"],"Rule %d":["\u041f\u0440\u0430\u0432\u0438\u043b\u043e %d"],"%1$s, rule %2$d":["%1$s, \u043f\u0440\u0430\u0432\u0438\u043b\u043e %2$d"],"Collapse %s":["\u0421\u0432\u0435\u0440\u043d\u0443\u0442\u044c %s"],"Expand %s":["\u0420\u0430\u0437\u0432\u0435\u0440\u043d\u0443\u0442\u044c %s"],"Move %s up":["\u041f\u0435\u0440\u0435\u043c\u0435\u0441\u0442\u0438\u0442\u044c %s \u0432\u0432\u0435\u0440\u0445"],"Move %s down":["\u041f\u0435\u0440\u0435\u043c\u0435\u0441\u0442\u0438\u0442\u044c %s \u0432\u043d\u0438\u0437"],"Always":["\u0412\u0441\u0435\u0433\u0434\u0430"],"Blocks rules below":["\u0411\u043b\u043e\u043a\u0438\u0440\u0443\u0435\u0442 \u043f\u0440\u0430\u0432\u0438\u043b\u0430 \u043d\u0438\u0436\u0435"],"Enable":["\u0412\u043a\u043b\u044e\u0447\u0438\u0442\u044c"],"Label":["\u041c\u0435\u0442\u043a\u0430"],"Admin label to identify this rule.":["\u041c\u0435\u0442\u043a\u0430 \u0434\u043b\u044f \u0438\u