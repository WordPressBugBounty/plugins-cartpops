u0434\u043b\u044f \u0442\u043e\u0432\u0430\u0440\u0456\u0432 \u0443 \u043a\u043e\u0448\u0438\u043a\u0443."],"Upsell Bundles":["\u041a\u043e\u043c\u043f\u043b\u0435\u043a\u0442\u0438 \u0430\u043f\u0441\u0435\u0439\u043b\u0443"],"No bundles configured yet. Add your first bundle below.":["\u041a\u043e\u043c\u043f\u043b\u0435\u043a\u0442\u0438 \u0449\u0435 \u043d\u0435 \u043d\u0430\u043b\u0430\u0448\u0442\u043e\u0432\u0430\u043d\u043e. \u0414\u043e\u0434\u0430\u0439\u0442\u0435 \u0441\u0432\u0456\u0439 \u043f\u0435\u0440\u0448\u0438\u0439 \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0442 \u043d\u0438\u0436\u0447\u0435."],"+ Add Upsell Bundle":["+ \u0414\u043e\u0434\u0430\u0442\u0438 \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0442 \u0430\u043f\u0441\u0435\u0439\u043b\u0443"],"Cart Expiry Timer":["\u0422\u0430\u0439\u043c\u0435\u0440 \u0437\u0430\u043a\u0456\u043d\u0447\u0435\u043d\u043d\u044f \u0434\u0456\u0457 \u043a\u043e\u0448\u0438\u043a\u0430"],"Custom Message":["\u0412\u043b\u0430\u0441\u043d\u0435 \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f"],"Product Spotlight":["\u0410\u043a\u0446\u0435\u043d\u0442 \u043d\u0430 \u0442\u043e\u0432\u0430\u0440\u0456"],"Info":["\u0406\u043d\u0444\u043e"],"Gift":["\u041f\u043e\u0434\u0430\u0440\u0443\u043d\u043e\u043a"],"Truck":["\u0412\u0430\u043d\u0442\u0430\u0436\u0456\u0432\u043a\u0430"],"Tag":["\u042f\u0440\u043b\u0438\u043a"],"Star":["\u0417\u0456\u0440\u043a\u0430"],"Clock":["\u0413\u043e\u0434\u0438\u043d\u043d\u0438\u043a"],"Clear Cart":["\u041e\u0447\u0438\u0441\u0442\u0438\u0442\u0438 \u043a\u043e\u0448\u0438\u043a"],"Redirect to Shop":["\u041f\u0435\u0440\u0435\u043d\u0430\u043f\u0440\u0430\u0432\u0438\u0442\u0438 \u0434\u043e \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0443"],"Rule %d":["\u041f\u0440\u0430\u0432\u0438\u043b\u043e %d"],"%1$s, rule %2$d":["%1$s, \u043f\u0440\u0430\u0432\u0438\u043b\u043e %2$d"],"Collapse %s":["\u0417\u0433\u043e\u0440\u043d\u0443\u0442\u0438 %s"],"Expand %s":["\u0420\u043e\u0437\u0433\u043e\u0440\u043d\u0443\u0442\u0438 %s"],"Move %s up":["\u041f\u0435\u0440\u0435\u043c\u0456\u0441\u0442\u0438\u0442\u0438 %s \u0432\u0433\u043e\u0440\u0443"],"Move %s down":["\u041f\u0435\u0440\u0435\u043c\u0456\u0441\u0442\u0438\u0442\u0438 %s \u0432\u043d\u0438\u0437"],"Always":["\u0417\u0430\u0432\u0436\u0434\u0438"],"Blocks rules below":["\u0411\u043b\u043e\u043a\u0443\u0454 \u043f\u0440\u0430\u0432\u0438\u043b\u0430 \u043d\u0438\u0436\u0447\u0435"],"Enable":["\u0423\u0432\u0456\u043c\u043a\u043d\u0443\u0442\u0438"],"Label":["\u041c\u0456\u0442\u043a\u0430"],"Admin label to identify this rule.":["\u041c\u0456\u0442\u043a\u0430 \u0430\u0434\u043c\u0456\u043d\u0456\u0441\u0442\u0440\u0430\u0442\u043e\u0440\u0430 \u0434\u043b\u044f \u0456\u0434\u0435\u043d\u0442\u0438\u0444\u0456\u043a\u0430\u0446\u0456\u0457 \u0446\u044c\u043e\u0433\u043e \u043f\u0440\u0430\u0432\u0438\u043b\u0430."],"Mode":["\u0420\u0435\u0436\u0438\u043c"],"Dismissible":["\u041c\u043e\u0436\u043d\u0430 \u0437\u0430\u043a\u0440\u0438\u0442\u0438"],"Allow customers to close this bar.":["\u0414\u043e\u0437\u0432\u043e\u043b\u0438\u0442\u0438 \u043f\u043e\u043a\u0443\u043f\u0446\u044f\u043c \u0437\u0430\u043a\u0440\u0438\u0432\u0430\u0442\u0438 \u0446\u044e \u043f\u0430\u043d\u0435\u043b\u044c."],"Duration (minutes)":["\u0422\u0440\u0438\u0432\u0430\u043b\u0456\u0441\u0442\u044c (\u0445\u0432\u0438\u043b\u0438\u043d\u0438)"],"Message":["\u041f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f"],"Use {{timer}} as a placeholder for the countdown.":["\u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0439\u0442\u0435 {{timer}} \u044f\u043a \u0437\u0430\u043f\u043e\u0432\u043d\u044e\u0432\u0430\u0447 \u0434\u043b\u044f \u0437\u0432\u043e\u0440\u043e\u0442\u043d\u043e\u0433\u043e \u0432\u0456\u0434\u043b\u0456\u043a\u0443."],"Action on Expiry":["\u0414\u0456\u044f \u043f\u0456\u0441\u043b\u044f \u0437\u0430\u043a\u0456\u043d\u0447\u0435\u043d\u043d\u044f \u0442\u0435\u0440\u043c\u0456\u043d\u0443"],"What happens when the timer reaches zero.":["\u0429\u043e \u0432\u0456\u0434\u0431\u0443\u0432\u0430\u0454\u0442\u044c\u0441\u044f, \u043a\u043e\u043b\u0438 \u0442\u0430\u0439\u043c\u0435\u0440 \u0434\u043e\u0441\u044f\u0433\u0430\u0454 \u043d\u0443\u043b\u044f."],"Free shipping this weekend!":["\u0411\u0435\u0437\u043a\u043e\u0448\u0442\u043e\u0432\u043d\u0430 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0430 \u0446\u0438\u043c\u0438 \u0432\u0438\u0445\u0456\u0434\u043d\u0438\u043c\u0438!"],"Link Text":["\u0422\u0435\u043a\u0441\u0442 \u043f\u043e\u0441\u0438\u043b\u0430\u043d\u043d\u044f"],"Shop now":["\u041a\u0443\u043f\u0438\u0442\u0438 \u0437\u0430\u0440\u0430\u0437"],"Link URL":["URL-\u0430\u0434\u0440\u0435\u0441\u0430 \u043f\u043e\u0441\u0438\u043b\u0430\u043d\u043d\u044f"],"Show when cart is empty":["\u041f\u043e\u043a\u0430\u0437\u0443\u0432\u0430\u0442\u0438, \u043a\u043e\u043b\u0438 \u043a\u043e\u0448\u0438\u043a \u043f\u043e\u0440\u043e\u0436\u043d\u0456\u0439"],"Also display this message when the cart has no items.":["\u0422\u0430\u043a\u043e\u0436 \u043f\u043e\u043a\u0430\u0437\u0443\u0432\u0430\u0442\u0438 \u0446\u0435 \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f, \u043a\u043e\u043b\u0438 \u0432 \u043a\u043e\u0448\u0438\u043a\u0443 \u043d\u0435\u043c\u0430\u0454 \u0442\u043e\u0432\u0430\u0440\u0456\u0432."],"Discount %":["\u0417\u043d\u0438\u0436\u043a\u0430 %"],"Percentage discount applied when the customer adds this product.":["\u0412\u0456\u0434\u0441\u043e\u0442\u043a\u043e\u0432\u0430 \u0437\u043d\u0438\u0436\u043a\u0430, \u044f\u043a\u0430 \u0437\u0430\u0441\u0442\u043e\u0441\u043e\u0432\u0443\u0454\u0442\u044c\u0441\u044f, \u043a\u043e\u043b\u0438 \u043f\u043e\u043a\u0443\u043f\u0435\u0446\u044c \u0434\u043e\u0434\u0430\u0454 \u0446\u0435\u0439 \u0442\u043e\u0432\u0430\u0440."],"Use {{product}} and {{discount}} as placeholders.":["\u0412\u0438\u043a\u043e\u0440\