msgstr "Tato nastavení nyní fungují trochu jinak:"

#: src/Setup/Upgrader.php:1964
msgid "Your custom JavaScript from version 1 is kept but not run."
msgstr "Váš vlastní JavaScript z verze 1 je zachován, ale není spuštěn."

#: src/Setup/Upgrader.php:1967
msgid "Some Pro settings from version 1 are kept in your database but not used."
msgstr ""
"Některá nastavení Pro z verze 1 jsou zachována v databázi, ale nejsou "
"používána."

