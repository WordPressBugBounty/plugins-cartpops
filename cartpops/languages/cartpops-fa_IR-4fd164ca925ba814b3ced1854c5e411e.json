s \u0627\u0632 \u067e\u06cc\u0634\u0648\u0646\u062f \u200e.cpops-\u200e \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f."],"Performance":["\u0639\u0645\u0644\u06a9\u0631\u062f"],"Import \/ Export":["\u062f\u0631\u0648\u0646\u200c\u0631\u06cc\u0632\u06cc \/ \u0628\u0631\u0648\u0646\u200c\u0628\u0631\u06cc"],"Export your CartPops settings to a JSON file for backup, or import settings from another site.":["\u062a\u0646\u0638\u06cc\u0645\u0627\u062a CartPops \u062e\u0648\u062f \u0631\u0627 \u0628\u0631\u0627\u06cc \u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u200c\u06af\u06cc\u0631\u06cc \u062f\u0631 \u06cc\u06a9 \u0641\u0627\u06cc\u0644 JSON \u0628\u0631\u0648\u0646\u200c\u0628\u0631\u06cc \u06a9\u0646\u06cc\u062f\u060c \u06cc\u0627 \u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u0631\u0627 \u0627\u0632 \u0633\u0627\u06cc\u062a \u062f\u06cc\u06af\u0631\u06cc \u062f\u0631\u0648\u0646\u200c\u0631\u06cc\u0632\u06cc \u0646\u0645\u0627\u06cc\u06cc\u062f."],"Export Settings":["\u0628\u0631\u0648\u0646\u200c\u0628\u0631\u06cc \u062a\u0646\u0638\u06cc\u0645\u0627\u062a"],"Import Settings":["\u062f\u0631\u0648\u0646\u200c\u0631\u06cc\u0632\u06cc \u062a\u0646\u0638\u06cc\u0645\u0627\u062a"],"Reset":["\u0628\u0627\u0632\u0646\u0634\u0627\u0646\u06cc"],"Reset all settings to defaults":["\u0628\u0627\u0632\u0646\u0634\u0627\u0646\u06cc \u0647\u0645\u0647 \u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u0628\u0647 \u0645\u0642\u0627\u062f\u06cc\u0631 \u067e\u06cc\u0634\u200c\u0641\u0631\u0636"],"Are you sure? This will reset all CartPops settings to their default values.":["\u0622\u06cc\u0627 \u0645\u0637\u0645\u0626\u0646 \u0647\u0633\u062a\u06cc\u062f\u061f \u0628\u0627 \u0627\u06cc\u0646 \u06a9\u0627\u0631 \u062a\u0645\u0627\u0645 \u062a\u0646\u0638\u06cc\u0645\u0627\u062a CartPops \u0628\u0647 \u0645\u0642\u0627\u062f\u06cc\u0631 \u067e\u06cc\u0634\u200c\u0641\u0631\u0636 \u0628\u0627\u0632\u0646\u0634\u0627\u0646\u06cc \u0645\u06cc\u200c\u0634\u0648\u0646