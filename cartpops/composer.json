{
  "name": "cartpops/cartpops",
  "description": "The #1 WooCommerce cart drawer plugin. Boost conversions with a beautiful slide-out cart, product recommendations, and free shipping meter.",
  "type": "wordpress-plugin",
  "license": "GPL-3.0-or-later",
  "require": {
    "freemius/wordpress-sdk": ">=2.13.4 <=2.13.4",
    "php": ">=8.1"
  },
  "require-dev": {
    "php-stubs/woocommerce-stubs": "^10.8",
    "php-stubs/wordpress-stubs": "^6.9",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpstan/phpstan": "^1.10",
    "phpunit/phpunit": "^10.0",
    "squizlabs/php_codesniffer": "^3.13.6",
    "szepeviktor/phpstan-wordpress": "^1.3",
    "wp-coding-standards/wpcs": "^3.4.1"
  },
  "autoload": {
    "psr-4": {
      "CartPops\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CartPops\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": false,
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit",
    "phpstan": "phpstan analyse --memory-limit=2G",
    "phpcs": "@php vendor/bin/phpcs --runtime-set installed_paths ../../wp-coding-standards/wpcs,../../phpcompatibility/php-compatibility,../../phpcompatibility/phpcompatibility-wp,../../phpcompatibility/phpcompatibility-paragonie,../../phpcsstandards/phpcsextra,../../phpcsstandards/phpcsutils",
    "phpcbf": "@php vendor/bin/phpcbf --runtime-set installed_paths ../../wp-coding-standards/wpcs,../../phpcompatibility/php-compatibility,../../phpcompatibility/phpcompatibility-wp,../../phpcompatibility/phpcompatibility-paragonie,../../phpcsstandards/phpcsextra,../../phpcsstandards/phpcsutils"
  }
}
