\u0438."],"Reward Type":["\u0422\u0438\u043f \u0432\u0438\u043d\u0430\u0433\u043e\u0440\u043e\u0434\u0438"],"Free Gift Product":["\u0411\u0435\u0437\u043a\u043e\u0448\u0442\u043e\u0432\u043d\u0438\u0439 \u043f\u043e\u0434\u0430\u0440\u0443\u043d\u043a\u043e\u0432\u0438\u0439 \u0442\u043e\u0432\u0430\u0440"],"Search simple products by name. To select a specific variation, enter its exact variation ID.":["\u0428\u0443\u043a\u0430\u0439\u0442\u0435 \u043f\u0440\u043e\u0441\u0442\u0456 \u0442\u043e\u0432\u0430\u0440\u0438 \u0437\u0430 \u043d\u0430\u0437\u0432\u043e\u044e. \u0429\u043e\u0431 \u0432\u0438\u0431\u0440\u0430\u0442\u0438 \u043f\u0435\u0432\u043d\u0443 \u0432\u0430\u0440\u0456\u0430\u0446\u0456\u044e, \u0432\u0432\u0435\u0434\u0456\u0442\u044c \u0457\u0457 \u0442\u043e\u0447\u043d\u0438\u0439 ID \u0432\u0430\u0440\u0456\u0430\u0446\u0456\u0457."],"Show Celebration":["\u041f\u043e\u043a\u0430\u0437\u0443\u0432\u0430\u0442\u0438 \u0441\u0432\u044f\u0442\u043a\u0443\u0432\u0430\u043d\u043d\u044f"],"Display confetti animation when this tier is reached.":["\u041f\u043e\u043a\u0430\u0437\u0443\u0432\u0430\u0442\u0438 \u0430\u043d\u0456\u043c\u0430\u0446\u0456\u044e \u043a\u043e\u043d\u0444\u0435\u0442\u0456 \u043f\u0440\u0438 \u0434\u043e\u0441\u044f\u0433\u043d\u0435\u043d\u043d\u0456 \u0446\u044c\u043e\u0433\u043e \u0440\u0456\u0432\u043d\u044f."],"Progress Message":["\u041f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f \u043f\u0440\u043e \u043f\u0440\u043e\u0433\u0440\u0435\u0441"],"Use {{amount}} and {{reward}} as placeholders.":["\u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0439\u0442\u0435 {{amount}} \u0442\u0430 {{reward}} \u044f\u043a \u0437\u0430\u043f\u043e\u0432\u043d\u044e\u0432\u0430\u0447\u0456."],"Qualified Message":["\u041f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f \u043f\u0440\u043e \u0434\u043e\u0441\u044f\u0433\u043d\u0435\u043d\u043d\u044f"],"Use {{reward}} as a placeholder.":["\u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0439\u0442\u0435 {{reward}} \u044f\u043a \u0437\u0430\u043f\u043e\u0432\u043d\u044e\u0432\u0430\u0447."],"Remove Tier":["\u0412\u0438\u0434\u0430\u043b\u0438\u0442\u0438 \u0440\u0456\u0432\u0435\u043d\u044c"],"Enable Shipping Meter":["\u0423\u0432\u0456\u043c\u043a\u043d\u0443\u0442\u0438 \u0448\u043a\u0430\u043b\u0443 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0438"],"Display a progress bar toward reward thresholds.":["\u041f\u043e\u043a\u0430\u0437\u0443\u0432\u0430\u0442\u0438 \u0456\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0443 \u0434\u043e \u0434\u043e\u0441\u044f\u0433\u043d\u0435\u043d\u043d\u044f \u043f\u043e\u0440\u043e\u0433\u0456\u0432 \u0432\u0438\u043d\u0430\u0433\u043e\u0440\u043e\u0434."],"Reward Tiers":["\u0420\u0456\u0432\u043d\u0456 \u0432\u0438\u043d\u0430\u0433\u043e\u0440\u043e\u0434"],"Tier 1":["\u0420\u0456\u0432\u0435\u043d\u044c 1"],"Display confetti animation when free shipping is reached.":["\u041f\u043e\u043a\u0430\u0437\u0443\u0432\u0430\u0442\u0438 \u0430\u043d\u0456\u043c\u0430\u0446\u0456\u044e \u043a\u043e\u043d\u0444\u0435\u0442\u0456 \u043f\u0440\u0438 \u0434\u043e\u0441\u044f\u0433\u043d\u0435\u043d\u043d\u0456 \u0431\u0435\u0437\u043a\u043e\u0448\u0442\u043e\u0432\u043d\u043e\u0457 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0438."],"Use {{amount}} as a placeholder for the remaining amount.":["\u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0439\u0442\u0435 {{amount}} \u044f\u043a \u0437\u0430\u043f\u043e\u0432\u043d\u044e\u0432\u0430\u0447 \u0434\u043b\u044f \u0441\u0443\u043c\u0438, \u0449\u043e \u0437\u0430\u043b\u0438\u0448\u0438\u043b\u0430\u0441\u044f."],"+ Add Tier":["+ \u0414\u043e\u0434\u0430\u0442\u0438 \u0440\u0456\u0432\u0435\u043d\u044c"],"Show in drawer":["\u041f\u043e\u043a\u0430\u0437\u0443\u0432\u0430\u0442\u0438 \u0443 \u0432\u0438\u0441\u0443\u0432\u043d\u043e\u043c\u0443 \u043a\u043e\u0448\u0438\u043a\u0443"],"Enable shipping calculator":["\u0423\u0432\u0456\u043c\u043a\u043d\u0443\u0442\u0438 \u043a\u0430\u043b\u044c\u043a\u0443\u043b\u044f\u0442\u043e\u0440 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0438"],"Let customers calculate shipping and choose an available rate from the cart drawer.":["\u0414\u043e\u0437\u0432\u043e\u043b\u0438\u0442\u0438 \u043a\u043b\u0456\u0454\u043d\u0442\u0430\u043c \u0440\u043e\u0437\u0440\u0430\u0445\u043e\u0432\u0443\u0432\u0430\u0442\u0438 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0443 \u0442\u0430 \u0432\u0438\u0431\u0438\u0440\u0430\u0442\u0438 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0438\u0439 \u0442\u0430\u0440\u0438\u0444 \u0443 \u0432\u0438\u0441\u0443\u0432\u043d\u043e\u043c\u0443 \u043a\u043e\u0448\u0438\u043a\u0443."],"Show icon":["\u041f\u043e\u043a\u0430\u0437\u0443\u0432\u0430\u0442\u0438 \u043f\u0456\u043a\u0442\u043e\u0433\u0440\u0430\u043c\u0443"],"Display truck\/checkmark icon before the message.":["\u0412\u0456\u0434\u043e\u0431\u0440\u0430\u0436\u0430\u0442\u0438 \u043f\u0456\u043a\u0442\u043e\u0433\u0440\u0430\u043c\u0443 \u0432\u0430\u043d\u0442\u0430\u0436\u0456\u0432\u043a\u0438\/\u0433\u0430\u043b\u043e\u0447\u043a\u0438 \u043f\u0435\u0440\u0435\u0434 \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f\u043c."],"Show truck indicator":["\u041f\u043e\u043a\u0430\u0437\u0443\u0432\u0430\u0442\u0438 \u0456\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0432\u0430\u043d\u0442\u0430\u0436\u0456\u0432\u043a\u0438"],"Display the moving truck on the progress bar. Hidden when reward tiers are active.":["\u0412\u0456\u0434\u043e\u0431\u0440\u0430\u0436\u0430\u0442\u0438 \u0440\u0443\u0445\u043e\u043c\u0443 \u0432\u0430\u043d\u0442\u0430\u0436\u0456\u0432\u043a\u0443 \u043d\u0430 \u0448\u043a\u0430\u043b\u0456 \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0443. \u041f\u0440\u0438\u0445\u043e\u0432\u0430\u043d\u043e, \u043a\u043e\u043b\u0438 \u0430\u043a\u0442\u0438\u0432\u043d\u0456 \u0440\u0456\u0432\u043d\u0456 \u0432\u0438\u043d\u0430\u0433\u043e\u0440\u043e\u0434."],"Progress Colors":["\u041a\u043e\u043b\u044c\u043e\u0440\u0438 \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0443"],"Bar Start":["\u041f\u043e\u0447\u0430\u0442\u043e\u043a \u0448\u043a\u0430\u043b\u0438"],"Bar End":["\u041a\u0456\u043d\u0435\u0446\u044c \u0448\u043a\u0430\u043b\u0438"],"Icon Background":["\u0424\u043e\u043d \u043f\u0456\u043a\u0442\u043e\u0433\u0440\u0430\u043c\u0438"],"Truck Background":["\u0424\u043e\u043d \u0432\u0430\u043d\u0442\u0430\u0436\u0456\u0432\u043a\u0438"],"Truck Icon":["\u041f\u0456\u043a\u0442\u043e\u0433\u0440\u0430\u043c\u0430 \u0432\u0430\u043d\u0442\u0430\u0436\u0456\u0432\u043a\u0438"],"Tier Reached":["\u0420\u0456\u0432\u0435\u043d\u044c \u0434\u043e\u0441\u044f\u0433\u043d\u0443\u0442\u043e"],"Tier Icon":["\u041f\u0456\u043a\u0442\u043e\u0433\u0440\u0430\u043c\u0430 \u0440\u0456\u0432\u043d\u044f"],"Qualified Colors":["\u041a\u043e\u043b\u044c\u043e\u0440\u0438 \u0434\u043e\u0441\u044f\u0433\u043d\u0435\u043d\u043d\u044f \u043c\u0435\u0442\u0438"],"Shield (Protection)":["\u0429\u0438\u0442 (\u0417\u0430\u0445\u0438\u0441\u0442)"],"Heart":["\u0421\u0435\u0440\u0446\u0435"],"Sparkles":["\u0411\u043b\u0438\u0441\u043a\u0456\u0442\u043a\u0438"],"Use whole currency units.":["\u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0439\u0442\u0435 \u0446\u0456\u043b\u0456 \u0433\u0440\u043e\u0448\u043e\u0432\u0456 \u043e\u0434\u0438\u043d\u0438\u0446\u0456."],"Use no more than %d decimal place.":["\u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0439\u0442\u0435 \u043d\u0435 \u0431\u0456\u043b\u044c\u0448\u0435 %d \u0437\u043d\u0430\u043a\u0430 \u043f\u0456\u0441\u043b\u044f \u043a\u043e\u043c\u0438.","\u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0439\u0442\u0435 \u043d\u0435 \u0431\u0456\u043b\u044c\u0448\u0435 %d \u0437\u043d\u0430\u043a\u0456\u0432 \u043f\u0456\u0441\u043b\u044f \u043a\u043e\u043c\u0438.","\u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0439\u0442\u0435 \u043d\u0435 \u0431\u0456\u043b\u044c\u0448\u0435 %d \u0437\u043d\u0430\u043a\u0456\u0432 \u043f\u0456\u0441\u043b\u044f \u043a\u043e\u043c\u0438."],"Enter a positive charge of at least %s.":["\u0412\u0432\u0435\u0434\u0456\u0442\u044c \u0434\u043e\u0434\u0430\u0442\u043d\u0443 \u0441\u0443\u043c\u0443 \u0449\u043e\u043d\u0430\u0439\u043c\u0435\u043d\u0448\u0435 %s."],"This draft will not be saved until corrected.":["\u0426\u044e \u0447\u0435\u0440\u043d\u0435\u0442\u043a\u0443 \u043d\u0435 \u0431\u0443\u0434\u0435 \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043e \u0434\u043e \u0432\u0438\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043d\u044f."],"Configure add-on options that customers can toggle in the cart drawer.":["\u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0439\u0442\u0435 \u0434\u043e\u0434\u0430\u0442\u043a\u043e\u0432\u0456 \u043e\u043f\u0446\u0456\u0457, \u044f\u043a\u0456 \u043a\u043b\u0456\u0454\u043d\u0442\u0438 \u043c\u043e\u0436\u0443\u0442\u044c \u043f\u0435\u0440\u0435\u043c\u0438\u043a\u0430\u0442\u0438 \u0443 \u0432\u0438\u0441\u0443\u0432\u043d\u043e\u043c\u0443 \u043a\u043e\u0448\u0438\u043a\u0443."],"Shipping Protection":["\u0417\u0430\u0445\u0438\u0441\u0442 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0438"],"Enable Shipping Protection":["\u0423\u0432\u0456\u043c\u043a\u043d\u0443\u0442\u0438 \u0437\u0430\u0445\u0438\u0441\u0442 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0438"],"Allow customers to add shipping protection to their order.":["\u0414\u043e\u0437\u0432\u043e\u043b\u0438\u0442\u0438 \u043a\u043b\u0456\u0454\u043d\u0442\u0430\u043c \u0434\u043e\u0434\u0430\u0432\u0430\u0442\u0438 \u0437\u0430\u0445\u0438\u0441\u0442 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0438 \u0434\u043e \u0441\u0432\u043e\u0433\u043e \u0437\u0430\u043c\u043e\u0432\u043b\u0435\u043d\u043d\u044f."],"Description":["\u041e\u043f\u0438\u0441"],"Protect your order from damage or loss":["\u0417\u0430\u0445\u0438\u0441\u0442\u0456\u0442\u044c \u0441\u0432\u043e\u0454 \u0437\u0430\u043c\u043e\u0432\u043b\u0435\u043d\u043d\u044f \u0432\u0456\u0434 \u043f\u043e\u0448\u043a\u043e\u0434\u0436\u0435\u043d\u043d\u044f \u0430\u0431\u043e \u0432\u0442\u0440\u0430\u0442\u0438"],"Price":["\u0426\u0456\u043d\u0430"],"Show Icon":["\u041f\u043e\u043a\u0430\u0437\u0443\u0432\u0430\u0442\u0438 \u043f\u0456\u043a\u0442\u043e\u0433\u0440\u0430\u043c\u0443"],"Display an icon next to the add-on in the cart drawer.":["\u0412\u0456\u0434\u043e\u0431\u0440\u0430\u0436\u0430\u0442\u0438 \u043f\u0456\u043a\u0442\u043e\u0433\u0440\u0430\u043c\u0443 \u043f\u043e\u0440\u0443\u0447 \u0456\u0437 \u0434\u043e\u0434\u0430\u0442\u043a\u043e\u0432\u043e\u044e \u043e\u043f\u0446\u0456\u0454\u044e \u0443 \u0432\u0438\u0441\u0443\u0432\u043d\u043e\u043c\u0443 \u043a\u043e\u0448\u0438\u043a\u0443."],"Default State":["\u0421\u0442\u0430\u043d \u0437\u0430 \u0437\u0430\u043c\u043e\u0432\u0447\u0443\u0432\u0430\u043d\u043d\u044f\u043c"],"Whether the add-on is toggled on or off by default for new visitors.":["\u0427\u0438 \u0443\u0432\u0456\u043c\u043a\u043d\u0435\u043d\u043e \u0434\u043e\u0434\u0430\u0442\u043e\u043a \u0437\u0430 \u0437\u0430\u043c\u043e\u0432\u0447\u0443\u0432\u0430\u043d\u043d\u044f\u043c \u0434\u043b\u044f \u043d\u043e\u0432\u0438\u0445 \u0432\u0456\u0434\u0432\u0456\u0434\u0443\u0432\u0430\u0447\u0456\u0432."],"Off (customer opts in)":["\u0412\u0438\u043c\u043a\u043d\u0435\u043d\u043e (\u043a\u043b\u0456\u0454\u043d\u0442 \u043f\u043e\u0433\u043e\u0434\u0436\u0443\u0454\u0442\u044c\u0441\u044f)"],"On (customer opts out)":["\u0423\u0432\u0456\u043c\u043a\u043d\u0435\u043d\u043e (\u043a\u043b\u0456\u0454\u043d\u0442 \u0432\u0456\u0434\u043c\u043e\u0432\u043b\u044f\u0454\u0442\u044c\u0441\u044f)"],"WooCommerce minimum":["\u041c\u0456\u043d\u0456\u043c\u0443\u043c WooCommerce"],"Free shipping comes from WooCommerce, not from this meter. Add a Free shipping method with a minimum order amount to your shipping zones in WooCommerce \u2192 Settings \u2192 Shipping. The meter only shows when the shopper\u2019s zone has one.":["\u0411\u0435\u0437\u043f\u043b\u0430\u0442\u043d\u0430 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0430 \u043d\u0430\u0434\u0445\u043e\u0434\u0438\u0442\u044c \u0432\u0456\u0434 WooCommerce, \u0430 \u043d\u0435 \u0432\u0456\u0434 \u0446\u044c\u043e\u0433\u043e \u043b\u0456\u0447\u0438\u043b\u044c\u043d\u0438\u043a\u0430. \u0414\u043e\u0434\u0430\u0439\u0442\u0435 \u043c\u0435\u0442\u043e\u0434 \u00ab\u0411\u0435\u0437\u043f\u043b\u0430\u0442\u043d\u0430 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0430\u00bb \u0437 \u043c\u0456\u043d\u0456\u043c\u0430\u043b\u044c\u043d\u043e\u044e \u0441\u0443\u043c\u043e\u044e \u0437\u0430\u043c\u043e\u0432\u043b\u0435\u043d\u043d\u044f \u0434\u043e \u0432\u0430\u0448\u0438\u0445 \u0437\u043e\u043d \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0438 \u0432 WooCommerce \u2192 \u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u2192 \u0414\u043e\u0441\u0442\u0430\u0432\u043a\u0430. \u041b\u0456\u0447\u0438\u043b\u044c\u043d\u0438\u043a \u0432\u0456\u0434\u043e\u0431\u0440\u0430\u0436\u0430\u0454\u0442\u044c\u0441\u044f \u0442\u0456\u043b\u044c\u043a\u0438 \u043a\u043e\u043b\u0438 \u0432 \u0437\u043e\u043d\u0456 \u043f\u043e\u043a\u0443\u043f\u0446\u044f \u0454 \u043e\u0434\u0438\u043d."],"Higher free shipping goal (optional)":["\u0412\u0438\u0449\u0430 \u043c\u0435\u0442\u0430 \u0431\u0435\u0437\u043f\u043b\u0430\u0442\u043d\u043e\u0457 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0438 (\u043d\u0435\u043e\u0431\u043e\u0432'\u044f\u0437\u043a\u043e\u0432\u043e)"],"Leave at 0 to use the minimum order amount from WooCommerce. A higher amount only raises the goal shown in the meter. It does not give free shipping by itself, and amounts below the WooCommerce minimum are ignored.":["\u0417\u0430\u043b\u0438\u0448\u0442\u0435 0, \u0449\u043e\u0431 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0432\u0430\u0442\u0438 \u043c\u0456\u043d\u0456\u043c\u0430\u043b\u044c\u043d\u0443 \u0441\u0443\u043c\u0443 \u0437\u0430\u043c\u043e\u0432\u043b\u0435\u043d\u043d\u044f \u0437 WooCommerce. \u0412\u0438\u0449\u0430 \u0441\u0443\u043c\u0430 \u0442\u0456\u043b\u044c\u043a\u0438 \u043f\u0456\u0434\u0432\u0438\u0449\u0443\u0454 \u043c\u0435\u0442\u0443, \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0443 \u0432 \u043b\u0456\u0447\u0438\u043b\u044c\u043d\u0438\u043a\u0443. \u0412\u043e\u043d\u0430 \u043d\u0435 \u043d\u0430\u0434\u0430\u0454 \u0431\u0435\u0437\u043f\u043b\u0430\u0442\u043d\u0443 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0443 \u0441\u0430\u043c\u0430 \u043f\u043e \u0441\u043e\u0431\u0456, \u0456 \u0441\u0443\u043c\u0438 \u043d\u0438\u0436\u0447\u0435 \u043c\u0456\u043d\u0456\u043c\u0443\u043c\u0443 WooCommerce \u0456\u0433\u043d\u043e\u0440\u0443\u044e\u0442\u044c\u0441\u044f."]}}}