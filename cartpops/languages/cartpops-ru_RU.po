msgstr[0] "%d другая настройка не могла быть перенесена."
msgstr[1] "%d другие настройки не могли быть перенесены."
msgstr[2] "%d других настроек не могли быть перенесены."

#: src/Setup/Upgrader.php:1982
msgid "See which settings"
msgstr "Посмотрите, какие настройки"

