u05d5\u05ea \u05dc\u05db\u05dc \u05d4\u05d9\u05d5\u05ea\u05e8."],"Enter a positive charge of at least %s.":["\u05d9\u05e9 \u05dc\u05d4\u05d6\u05d9\u05df \u05d7\u05d9\u05d5\u05d1 \u05d7\u05d9\u05d5\u05d1\u05d9 \u05e9\u05dc \u05dc\u05e4\u05d7\u05d5\u05ea %s."],"This draft will not be saved until corrected.":["\u05d8\u05d9\u05d5\u05d8\u05d4 \u05d6\u05d5 \u05dc\u05d0 \u05ea\u05d9\u05e9\u05de\u05e8 \u05e2\u05d3 \u05dc\u05ea\u05d9\u05e7\u05d5\u05df."],"Configure add-on options that customers can toggle in the cart drawer.":["\u05d4\u05d2\u05d3\u05e8\u05ea \u05d0\u05e4\u05e9\u05e8\u05d5\u05d9\u05d5\u05ea \u05ea\u05d5\u05e1\u05e4\u05d9\u05dd \u05e9\u05dc\u05e7\u05d5\u05d7\u05d5\u05ea \u05d9\u05db\u05d5\u05dc\u05d9\u05dd \u05dc\u05d4\u05e4\u05e2\u05d9\u05dc \u05d0\u05d5 \u05dc\u05db\u05d1\u05d5\u05ea \u05d1\u05de\u05d2\u05d9\u05e8\u05ea \u05e2\u05d2\u05dc\u05ea \u05d4\u05e7\u05e0\u05d9\u05d5\u05ea."],"Shipping Protection":["\u05d4\u05d2\u05e0\u05d4 \u05e2\u05dc \u05d4\u05de\u05e9\u05dc\u05d5\u05d7"],"Enable Shipping Protection":["\u05d4\u05e4\u05e2\u05dc\u05ea \u05d4\u05d2\u05e0\u05d4 \u05e2\u05dc \u05d4\u05de\u05e9\u05dc\u05d5\u05d7"],"Allow customers to add shipping protection to their order.":["\u05de\u05d0\u05e4\u05e9\u05e8 \u05dc\u05dc\u05e7\u05d5\u05d7\u05d5\u05ea \u05dc\u05d4\u05d5\u05e1\u05d9\u05e3 \u05d4\u05d2\u05e0\u05d4 \u05e2\u05dc \u05d4\u05de\u05e9\u05dc\u05d5\u05d7 \u05dc\u05d4\u05d6\u05de\u05e0\u05d4 \u05e9\u05dc\u05d4\u05dd."],"Description":["\u05ea\u05d9\u05d0\u05d5\u05e8"],"Protect your order from damage or loss":["\u05d4\u05d2\u05e0\u05d4 \u05e2\u05dc \u05d4\u05d4\u05d6\u05de\u05e0\u05d4 \u05de\u05e4\u05e0\u05d9 \u05e0\u05d6\u05e7 \u05d0\u05d5 \u05d0\u05d5\u05d1\u05d3\u05df"],"Price":["\u05de\u05d7\u05d9\u05e8"],"Show Icon":["\u05d4\u05e6\u05d2\u05ea \u05e1\u05de\u05dc"],"Display an icon next to the add-on in the cart drawer.":["\u05d4\u05e6\u05d2\u05ea \u05e1\u05de\u05dc \u05dc\u05e6\u05d3 \u05d4\u05ea\u05d5\u05e1\u05e3 \u05d1\u05de\u05d2\u05d9\u05e8\u05ea \u05e2\u05d2\u05dc\u05ea \u05d4\u05e7\u05e0\u05d9\u05d5\u05ea."],"Default State":["\u05de\u05e6\u05d1 \u05d1\u05e8\u05d9\u05e8\u05ea \u05de\u05d7\u05d3\u05dc"],"Whether the add-on is toggled on or off by default for new visitors.":["\u05d4\u05d0\u05dd \u05d4\u05ea\u05d5\u05e1\u05e3 \u05de\u05d5\u05e4\u05e2\u05dc \u05d0\u05d5 \u05db\u05d1\u05d5\u05d9 \u05db\u05d1\u05e8\u05d9\u05e8\u05ea \u05de\u05d7\u05d3\u05dc \u05e2\u05d1\u05d5\u05e8 \u05de\u05d1\u05e7\u05e8\u05d9\u05dd \u05d7\u05d3\u05e9\u05d9\u05dd."],"Off (customer opts in)":["\u05db\u05d1\u05d5\u05d9 (\u05d4\u05dc\u05e7\u05d5\u05d7 \u05d1\u05d5\u05d7\u05e8 \u05dc\u05d4\u05e4\u05e2\u05d9\u05dc)"],"On (customer opts out)":["\u05e4\u05e2\u05d9\u05dc (\u05d4\u05dc\u05e7\u05d5\u05d7 \u05de\u05d1\u05d8\u05dc \u05d4\u05e6\u05d8\u05e8\u05e4\u05d5\u05ea)"],"WooCommerce minimum":["\u05de\u05d9\u05e0\u05d9\u05de\u05d5\u05dd WooCommerce"],"Free shipping comes from WooCommerce, not from this meter. Add a Free shipping method with a minimum order amount to your shipping zones in WooCommerce \u2192 Settings \u2192 Shipping. The meter only shows when the shopper\u2019s zone has one.":["\u05de\u05e9\u05dc\u05d5\u05d7 \u05d7\u05d9\u05e0\u05dd \u05de\u05d2\u05d9\u05e2 \u05de-WooCommerce, \u05dc\u05d0 \u05de\u05d4\u05de\u05d3 \u05d4\u05d6\u05d4. \u05d4\u05d5\u05e1\u05e3 \u05e9\u05d9\u05d8\u05ea \u05de\u05e9\u05dc\u05d5\u05d7 \u05d7\u05d9\u05e0\u05dd \u05e2\u05dd \u05e1\u05db\u05d5\u05dd \u05d4\u05d6\u05de\u05e0\u05d4 \u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9 \u05dc\u05d0\u05d6\u05d5\u05e8\u05d9 \u05d4\u05de\u05e9\u05dc\u05d5\u05d7 \u05e9\u05dc\u05da \u05d1-WooCommerce \u2192 \u05d4\u05d2\u05d3\u05e8\u05d5\u05ea \u2192 \u05de\u05e9\u05dc\u05d5\u05d7. \u05d4\u05de\u05d3 \u05de\u05d5\u05e6\u05d2 \u05e8\u05e7 \u05db\u05d0\u05e9\u05e8 \u05dc\u05d0\u05d6\u05d5\u05e8 \u05e9\u05dc \u05d4\u05e7\u05d5\u05e0\u05d4 \u05d9\u05e9 \u05d0\u05d7\u05d3."],"Higher free shipping goal (optional)":["\u05de\u05d8\u05e8\u05ea \u05de\u05e9\u05dc\u05d5\u05d7 \u05d7\u05d9\u05e0\u05dd \u05d2\u05d1\u05d5\u05d4 \u05d9\u05d5\u05ea\u05e8 (\u05d0\u05d5\u05e4\u05e6\u05d9\u05d5\u05e0\u05dc\u05d9)"],"Leave at 0 to use the minimum order amount from WooCommerce. A higher amount only raises the goal shown in the meter. It does not give free shipping by itself, and amounts below the WooCommerce minimum are ignored.":["\u05d4\u05e9\u05d0\u05e8 \u05d1-0 \u05db\u05d3\u05d9 \u05dc\u05d4\u05e9\u05ea\u05de\u05e9 \u05d1\u05e1\u05db\u05d5\u05dd \u05d4\u05d4\u05d6\u05de\u05e0\u05d4 \u05d4\u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9 \u05de-WooCommerce. \u05e1\u05db\u05d5\u05dd \u05d2\u05d1\u05d5\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05e8\u05e7 \u05de\u05e2\u05dc\u05d4 \u05d0\u05ea \u05d4\u05de\u05d8\u05e8\u05d4 \u05d4\u05de\u05d5\u05e6\u05d2\u05ea \u05d1\u05de\u05d3. \u05d6\u05d4 \u05dc\u05d0 \u05e0\u05d5\u05ea\u05df \u05de\u05e9\u05dc\u05d5\u05d7 \u05d7\u05d9\u05e0\u05dd \u05d1\u05e2\u05e6\u05de\u05d5, \u05d5\u05e1\u05db\u05d5\u05de\u05d9\u05dd \u05de\u05ea\u05d7\u05ea \u05dc\u05de\u05d9\u05e0\u05d9\u05de\u05d5\u05dd WooCommerce \u05de\u05ea\u05e2\u05dc\u05de\u05d9\u05dd."]}}}