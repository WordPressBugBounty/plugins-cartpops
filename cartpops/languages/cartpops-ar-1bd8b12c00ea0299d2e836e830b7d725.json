kground":["\u062e\u0644\u0641\u064a\u0629 \u0627\u0644\u0623\u064a\u0642\u0648\u0646\u0629"],"Truck Background":["\u062e\u0644\u0641\u064a\u0629 \u0627\u0644\u0634\u0627\u062d\u0646\u0629"],"Truck Icon":["\u0623\u064a\u0642\u0648\u0646\u0629 \u0627\u0644\u0634\u0627\u062d\u0646\u0629"],"Tier Reached":["\u062a\u0645 \u0627\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u0649 \u0627\u0644\u0645\u0633\u062a\u0648\u0649"],"Tier Icon":["\u0623\u064a\u0642\u0648\u0646\u0629 \u0627\u0644\u0645\u0633\u062a\u0648\u0649"],"Qualified Colors":["\u0623\u0644\u0648\u0627\u0646 \u0627\u0644\u062a\u0623\u0647\u0644"],"Shield (Protection)":["\u062f\u0631\u0639 (\u062d\u0645\u0627\u064a\u0629)"],"Heart":["\u0642\u0644\u0628"],"Sparkles":["\u0628\u0631\u064a\u0642"],"Use whole currency units.":["\u0627\u0633\u062a\u062e\u062f\u0645 \u0648\u062d\u062f\u0627\u062a \u0639\u0645\u0644\u0629 \u0635\u062d\u064a\u062d\u0629."],"Use no more than %d decimal place.":["\u0644\u0627 \u062a\u0633\u062a\u062e\u062f\u0645 \u0623\u0643\u062b\u0631 \u0645\u0646 %d \u0645\u0646\u0632\u0644\u0629 \u0639\u0634\u0631\u064a\u0629.","\u0627\u0633\u062a\u062e\u062f\u0645 \u0645\u0627 \u0644\u0627 \u064a\u0632\u064a\u062f \u0639\u0646 %d \u0645\u0646\u0632\u0644\u0629 \u0639\u0634\u0631\u064a\u0629.","\u0627\u0633\u062a\u062e\u062f\u0645 \u0645\u0627 \u0644\u0627 \u064a\u0632\u064a\u062f \u0639\u0646 %d \u0645\u0646\u0632\u0644\u062a\u064a\u0646 \u0639\u0634\u0631\u064a\u062a\u064a\u0646.","\u0627\u0633\u062a\u062e\u062f\u0645 \u0645\u0627 \u0644\u0627 \u064a\u0632\u064a\u062f \u0639\u0646 %d \u0645\u0646\u0627\u0632\u0644 \u0639\u0634\u0631\u064a\u0629.","\u0627\u0633\u062a\u062e\u062f\u0645 \u0645\u0627 \u0644\u0627 \u064a\u0632\u064a\u062f \u0639\u0646 %d \u0645\u0646\u0632\u0644\u0629 \u0639\u0634\u0631\u064a\u0629.","\u0627\u0633\u062a\u062e\u062f\u0645 \u0645\u0627 \u0644\u0627 \u064a\u0632\u064a\u062f \u0639\u0646 %d \u0645\u0646\u0632\u0644\u0629 \u0639\u0634\u0631\u064a\u0629."],"Enter a positive charge of at least %s.":["\u0623\u062f\u062e\u0644 \u0631\u0633\u0648\u0645\u064b\u0627 \u0645\u0648\u062c\u0628\u0629 \u0628\u0642\u064a\u0645\u0629 %s \u0639\u0644\u0649 \u0627\u0644\u0623\u0642\u0644."],"This draft will not be saved until corrected.":["\u0644\u0646 \u064a\u062a\u0645 \u062d\u0641\u0638 \u0647\u0630\u0647 \u0627\u0644\u0645\u0633\u0648\u062f\u0629 \u062d\u062a\u0649 \u064a\u062a\u0645 \u062a\u0635\u062d\u064a\u062d\u0647\u0627."],"Configure add-on options that customers can toggle in the cart drawer.":["\u062a\u0643\u0648\u064a\u0646 \u062e\u064a\u0627\u0631\u0627\u062a \u0627\u0644\u0625\u0636\u0627\u0641\u0627\u062a \u0627\u0644\u062a\u064a \u064a\u0645\u0643\u0646 \u0644\u0644\u0639\u0645\u0644\u0627\u0621 \u062a\u0641\u0639\u064a\u0644\u0647\u0627 \u0641\u064a \u062f\u0631\u062c \u0627\u0644\u0633\u0644\u0629."],"Shipping Protection":["\u062d\u0645\u0627\u064a\u0629 \u0627\u0644\u0634\u062d\u0646"],"Enable Shipping Protection":["\u062a\u0645\u0643\u064a\u0646 \u062d\u0645\u0627\u064a\u0629 \u0627\u0644\u0634\u062d\u0646"],"Allow customers to add shipping protection to their order.":["\u0627\u0644\u0633\u0645\u0627\u062d \u0644\u0644\u0639\u0645\u0644\u0627\u0621 \u0628\u0625\u0636\u0627\u0641\u0629 \u062d\u0645\u0627\u064a\u0629 \u0627\u0644\u0634\u062d\u0646 \u0625\u0644\u0649 \u0637\u0644\u0628\u0627\u062a\u0647\u0645."],"Description":["\u0627\u0644\u0648\u0635\u0641"],"Protect your order from damage or loss":["\u0627\u062d\u0645\u0650 \u0637\u0644\u0628\u0643 \u0645\u0646 \u0627\u0644\u062a\u0644\u0641 \u0623\u0648 \u0627\u0644\u0641\u0642\u062f\u0627\u0646"],"Price":["\u0627\u0644\u0633\u0639\u0631"],"Show Icon":["\u0625\u0638\u0647\u0627\u0631 \u0627\u0644\u0623\u064a\u0642\u0648\u0646\u0629"],"Display an icon next to the add-on in the cart drawer.":["\u0639\u0631\u0636 \u0623\u064a\u0642\u0648\u0646\u0629 \u0628\u062c\u0648\u0627\u0631 \u0627\u0644\u0625\u0636\u0627\u0641\u0629 \u0641\u064a \u062f\u0631\u062c \u0627\u0644\u0633\u0644\u0629."],"Default State":["\u0627\u0644\u062d\u0627\u0644\u0629 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a\u0629"],"Whether the add-on is toggled on or off by default for new visitors.":["\u062a\u062d\u062f\u064a\u062f \u0645\u0627 \u0625\u0630\u0627 \u0643\u0627\u0646\u062a \u0627\u0644\u0625\u0636\u0627\u0641\u0629 \u0645\u0641\u0639\u0651\u0644\u0629 \u0623\u0648 \u0645\u0639\u0637\u0651\u0644\u0629 \u0627\u0641\u062a\u0631\u0627\u0636\u064a\u0627\u064b \u0644\u0644\u0632\u0648\u0627\u0631 \u0627\u0644\u062c\u062f\u062f."],"Off (customer opts in)":["\u0645\u0639\u0637\u0651\u0644 (\u064a\u0634\u062a\u0631\u0643 \u0627\u0644\u0639\u0645\u064a\u0644 \u0628\u0627\u062e\u062a\u064a\u0627\u0631\u0647)"],"On (customer opts out)":["\u0645\u0641\u0639\u0651\u0644 (\u064a\u0644\u063a\u064a \u0627\u0644\u0639\u0645\u064a\u0644 \u0627\u0644\u0627\u0634\u062a\u0631\u0627\u0643 \u0628\u0627\u062e\u062a\u064a\u0627\u0631\u0647)"],"WooCommerce minimum":["\u0627\u0644\u062d\u062f \u0627\u0644\u0623\u062f\u0646\u0649 \u0645\u0646 WooCommerce"],"Free shipping comes from WooCommerce, not from this meter. Add a Free shipping method with a minimum order amount to your shipping zones in WooCommerce \u2192 Settings \u2192 Shipping. The meter only shows when the shopper\u2019s zone has one.":["\u0627\u0644\u0634\u062d\u0646 \u0627\u0644\u0645\u062c\u0627\u0646\u064a \u064a\u0623\u062a\u064a \u0645\u0646 WooCommerce\u060c \u0648\u0644\u064a\u0633 \u0645\u0646 \u0647\u0630\u0627 \u0627\u0644\u0639\u062f\u0627\u062f. \u0623\u0636\u0641 \u0637\u0631\u064a\u0642\u0629 \u0634\u062d\u0646 \u0645\u062c\u0627\u0646\u064a \u0628\u062d\u062f \u0623\u062f\u0646\u0649 \u0645\u0646 \u0645\u0628\u0644\u063a \u0627\u0644\u0637\u0644\u0628 \u0625\u0644\u0649 \u0645\u0646\u0627\u0637\u0642 \u0627\u0644\u0634\u062d\u0646 \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0643 \u0641\u064a WooCommerce \u2192 \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u2192 \u0627\u0644\u0634\u062d\u0646. \u064a\u0638\u0647\u0631 \u0627\u0644\u0639\u062f\u0627\u062f \u0641\u0642\u0637 \u0639\u0646\u062f\u0645\u0627 \u062a\u0643\u0648\u0646 \u0645\u0646\u0637\u0642\u0629 \u0627\u0644\u0645\u062a\u0633\u0648\u0642 \u0628\u0647\u0627 \u0648\u0627\u062d\u062f."],"Higher free shipping goal (optional)":["\u0647\u062f\u0641 \u0634\u062d\u0646 \u0645\u062c\u0627\u0646\u064a \u0623\u0639\u0644\u0649 (\u0627\u062e\u062a\u064a\u0627\u0631\u064a)"],"Leave at 0 to use the minimum order amount from WooCommerce. A higher amount only raises the goal shown in the meter. It does not give free shipping by itself, and amounts below the WooCommerce minimum are ignored.":["\u0627\u062a\u0631\u0643 \u0627\u0644\u0642\u064a\u0645\u0629 0 \u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u062d\u062f \u0627\u0644\u0623\u062f\u0646\u0649 \u0645\u0646 \u0645\u0628\u0644\u063a \u0627\u0644\u0637\u0644\u0628 \u0645\u0646 WooCommerce. \u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u0623\u0639\u0644\u0649 \u064a\u0631\u0641\u0639 \u0641\u0642\u0637 \u0627\u0644\u0647\u062f\u0641 \u0627\u0644\u0645\u0639\u0631\u0648\u0636 \u0641\u064a \u0627\u0644\u0639\u062f\u0627\u062f. \u0644\u0627 \u064a\u0648\u0641\u0631 \u0627\u0644\u0634\u062d\u0646 \u0627\u0644\u0645\u062c\u0627\u0646\u064a \u0628\u0646\u0641\u0633\u0647\u060c \u0648\u0627\u0644\u0645\u0628\u0627\u0644\u063a \u0623\u0642\u0644 \u0645\u0646 \u0627\u0644\u062d\u062f \u0627\u0644\u0623\u062f\u0646\u0649 \u0645\u0646 WooCommerce \u064a\u062a\u0645 \u062a\u062c\u0627\u0647\u0644\u0647\u0627."]}}}