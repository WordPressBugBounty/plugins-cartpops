\u0645\u06cc\u0646\u0647 \u06a9\u0627\u0645\u06cc\u0648\u0646"],"Truck Icon":["\u0622\u06cc\u06a9\u0648\u0646 \u06a9\u0627\u0645\u06cc\u0648\u0646"],"Tier Reached":["\u0633\u0637\u062d \u06a9\u0633\u0628\u200c\u0634\u062f\u0647"],"Tier Icon":["\u0622\u06cc\u06a9\u0648\u0646 \u0633\u0637\u062d"],"Qualified Colors":["\u0631\u0646\u06af\u200c\u0647\u0627\u06cc \u0648\u0627\u062c\u062f \u0634\u0631\u0627\u06cc\u0637"],"Shield (Protection)":["\u0633\u067e\u0631 (\u0645\u062d\u0627\u0641\u0638\u062a)"],"Heart":["\u0642\u0644\u0628"],"Sparkles":["\u062f\u0631\u062e\u0634\u0634"],"Use whole currency units.":["\u0627\u0632 \u0648\u0627\u062d\u062f\u0647\u0627\u06cc \u0627\u0631\u0632\u06cc \u06a9\u0627\u0645\u0644 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u06a9\u0646\u06cc\u062f."],"Use no more than %d decimal place.":["\u0628\u06cc\u0634\u062a\u0631 \u0627\u0632 %d \u0631\u0642\u0645 \u0627\u0639\u0634\u0627\u0631 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0646\u06a9\u0646\u06cc\u062f.","\u0628\u06cc\u0634\u062a\u0631 \u0627\u0632 %d \u0631\u0642\u0645 \u0627\u0639\u0634\u0627\u0631 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0646\u06a9\u0646\u06cc\u062f."],"Enter a positive charge of at least %s.":["\u0645\u0628\u0644\u063a\u06cc \u0645\u062b\u0628\u062a \u0648 \u062d\u062f\u0627\u0642\u0644 %s \u0648\u0627\u0631\u062f \u06a9\u0646\u06cc\u062f."],"This draft will not be saved until corrected.":["\u0627\u06cc\u0646 \u067e\u06cc\u0634\u200c\u0646\u0648\u06cc\u0633 \u062a\u0627 \u0632\u0645\u0627\u0646 \u0627\u0635\u0644\u0627\u062d \u0630\u062e\u06cc\u0631\u0647 \u0646\u062e\u0648\u0627\u0647\u062f \u0634\u062f."],"Configure add-on options that customers can toggle in the cart drawer.":["\u062a\u0646\u0638\u06cc\u0645 \u06af\u0632\u06cc\u0646\u0647\u200c\u0647\u0627\u06cc \u0627\u0641\u0632\u0648\u062f\u0646\u06cc \u06a9\u0647 \u0645\u0634\u062a\u0631\u06cc\u0627\u0646 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u0646\u062f \u062f\u0631 \u06a9\u0634\u0648\u06cc \u0633\u0628\u062f \u062e\u0631\u06cc\u062f \u0641\u0639\u0627\u0644 \u06a9\u0646\u0646\u062f."],"Shipping Protection":["\u0645\u062d\u0627\u0641\u0638\u062a \u0627\u0632 \u0627\u0631\u0633\u0627\u0644"],"Enable Shipping Protection":["\u0641\u0639\u0627\u0644\u200c\u0633\u0627\u0632\u06cc \u0645\u062d\u0627\u0641\u0638\u062a \u0627\u0632 \u0627\u0631\u0633\u0627\u0644"],"Allow customers to add shipping protection to their order.":["\u0628\u0647 \u0645\u0634\u062a\u0631\u06cc\u0627\u0646 \u0627\u062c\u0627\u0632\u0647 \u062f\u0647\u06cc\u062f \u0627\u0645\u06a9\u0627\u0646 \u0645\u062d\u0627\u0641\u0638\u062a \u0627\u0632 \u0627\u0631\u0633\u0627\u0644 \u0631\u0627 \u0628\u0647 \u0633\u0641\u0627\u0631\u0634 \u062e\u0648\u062f \u0627\u0636\u0627\u0641\u0647 \u06a9\u0646\u0646\u062f."],"Description":["\u062a\u0648\u0636\u06cc\u062d\u0627\u062a"],"Protect your order from damage or loss":["\u0627\u0632 \u0633\u0641\u0627\u0631\u0634 \u062e\u0648\u062f \u062f\u0631 \u0628\u0631\u0627\u0628\u0631 \u0622\u0633\u06cc\u0628 \u06cc\u0627 \u0645\u0641\u0642\u0648\u062f\u06cc \u0645\u062d\u0627\u0641\u0638\u062a \u06a9\u0646\u06cc\u062f"],"Price":["\u0642\u06cc\u0645\u062a"],"Show Icon":["\u0646\u0645\u0627\u06cc\u0634 \u0622\u06cc\u06a9\u0648\u0646"],"Display an icon next to the add-on in the cart drawer.":["\u0646\u0645\u0627\u06cc\u0634 \u06cc\u06a9 \u0622\u06cc\u06a9\u0648\u0646 \u06a9\u0646\u0627\u0631 \u0627\u0641\u0632\u0648\u062f\u0646\u06cc \u062f\u0631 \u06a9\u0634\u0648\u06cc \u0633\u0628\u062f \u062e\u0631\u06cc\u062f."],"Default State":["\u0648\u0636\u0639\u06cc\u062a \u067e\u06cc\u0634\u200c\u0641\u0631\u0636"],"Whether the add-on is toggled on or off by default for new visitors.":["\u0622\u06cc\u0627 \u0627\u0641\u0632\u0648\u062f\u0646\u06cc \u0628\u0631\u0627\u06cc \u0628\u0627\u0632\u062f\u06cc\u062f\u06a9\u0646\u0646\u062f\u06af\u0627\u0646 \u062c\u062f\u06cc\u062f \u0628\u0647\u200c\u0637\u0648\u0631 \u067e\u06cc\u0634\u200c\u0641\u0631\u0636 \u0631\u0648\u0634\u0646 \u0628\u0627\u0634\u062f \u06cc\u0627 \u062e\u0627\u0645\u0648\u0634."],"Off (customer opts in)":["\u062e\u0627\u0645\u0648\u0634 (\u0645\u0634\u062a\u0631\u06cc \u0627\u0646\u062a\u062e\u0627\u0628 \u0645\u06cc\u200c\u06a9\u0646\u062f)"],"On (customer opts out)":["\u0631\u0648\u0634\u0646 (\u0627\u0646\u0635\u0631\u0627\u0641 \u0645\u0634\u062a\u0631\u06cc)"],"WooCommerce minimum":["\u062d\u062f\u0627\u0642\u0644 WooCommerce"],"Free shipping comes from WooCommerce, not from this meter. Add a Free shipping method with a minimum order amount to your shipping zones in WooCommerce \u2192 Settings \u2192 Shipping. The meter only shows when the shopper\u2019s zone has one.":["\u062d\u0645\u0644\u200c\u0648\u0646\u0642\u0644 \u0631\u0627\u06cc\u06af\u0627\u0646 \u0627\u0632 WooCommerce \u0645\u06cc\u200c\u0622\u06cc\u062f\u060c \u0646\u0647 \u0627\u0632 \u0627\u06cc\u0646 \u0646\u0634\u0627\u0646\u06af\u0631. \u06cc\u06a9 \u0631\u0648\u0634 \u062d\u0645\u0644\u200c\u0648\u0646\u0642\u0644 \u0631\u0627\u06cc\u06af\u0627\u0646 \u0628\u0627 \u062d\u062f\u0627\u0642\u0644 \u0645\u0628\u0644\u063a \u0633\u0641\u0627\u0631\u0634 \u0628\u0647 \u0645\u0646\u0627\u0637\u0642 \u062d\u0645\u0644\u200c\u0648\u0646\u0642\u0644 \u062e\u0648\u062f \u062f\u0631 WooCommerce \u2192 \u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u2192 \u062d\u0645\u0644\u200c\u0648\u0646\u0642\u0644 \u0627\u0636\u0627\u0641\u0647 \u06a9\u0646\u06cc\u062f. \u0646\u0634\u0627\u0646\u06af\u0631 \u0641\u0642\u0637 \u0632\u0645\u0627\u0646\u06cc \u0646\u0645\u0627\u06cc\u0634 \u062f\u0627\u062f\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f \u06a9\u0647 \u0645\u0646\u0637\u0642\u0647 \u062e\u0631\u06cc\u062f\u0627\u0631 \u06cc\u06a9\u06cc \u062f\u0627\u0634\u062a\u0647 \u0628\u0627\u0634\u062f."],"Higher free shipping goal (optional)":["\u0647\u062f\u0641 \u062d\u0645\u0644\u200c\u0648\u0646\u0642\u0644 \u0631\u0627\u06cc\u06af\u0627\u0646 \u0628\u0627\u0644\u0627\u062a\u0631 (\u0627\u062e\u062a\u06cc\u0627\u0631\u06cc)"],"Leave at 0 to use the minimum order amount from WooCommerce. A higher amount only raises the goal shown in the meter. It does not give free shipping by itself, and amounts below the WooCommerce minimum are ignored.":["\u0628\u0631\u0627\u06cc \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u062d\u062f\u0627\u0642\u0644 \u0645\u0628\u0644\u063a \u0633\u0641\u0627\u0631\u0634 \u0627\u0632 WooCommerce\u060c \u0622\u0646 \u0631\u0627 \u062f\u0631 0 \u0631\u0647\u0627 \u06a9\u0646\u06cc\u062f. \u0645\u0628\u0644\u063a \u0628\u0627\u0644\u0627\u062a\u0631 \u0641\u0642\u0637 \u0647\u062f\u0641 \u0646\u0634\u0627\u0646\u200c\u062f\u0627\u062f\u0647\u200c\u0634\u062f\u0647 \u062f\u0631 \u0646\u0634\u0627\u0646\u06af\u0631 \u0631\u0627 \u0627\u0641\u0632\u0627\u06cc\u0634 \u0645\u06cc\u200c\u062f\u0647\u062f. \u0627\u06cc\u0646 \u062e\u0648\u062f \u062d\u0645\u0644\u200c\u0648\u0646\u0642\u0644 \u0631\u0627\u06cc\u06af\u0627\u0646 \u0631\u0627 \u0641\u0631\u0627\u0647\u0645 \u0646\u0645\u06cc\u200c\u06a9\u0646\u062f\u060c \u0648 \u0645\u0628\u0627\u0644\u063a \u06a9\u0645\u062a\u0631 \u0627\u0632 \u062d\u062f\u0627\u0642\u0644 WooCommerce \u0646\u0627\u062f\u06cc\u062f\u0647 \u06af\u0631\u0641\u062a\u0647 \u0645\u06cc\u200c\u0634\u0648\u0646\u062f."]}}}