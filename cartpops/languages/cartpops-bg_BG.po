msgstr[0] "%d друга настройка не можа да бъде пренесена."
msgstr[1] "%d други настройки не можаха да бъдат пренесени."

#: src/Setup/Upgrader.php:1982
msgid "See which settings"
msgstr "Вижте кои настройки"

#: src/Setup/Upgrader.php:2000
msgid "Show your saved custom JavaScript"
msgstr "Покажи твоя запазен персонализиран JavaScript"

#: src/Setup/Upgrader.php:2001
msgid ""
"Copy it somewhere safe if you want to move it into your theme or a snippets "
"plugin."
msgstr ""
"Копирай го някъде в безопасност, ако искаш да го преместиш в твоята тема "
"или плъгин със фрагменти."

#: src/Setup/Upgrader.php:2004
msgid "Only the beginning is shown. The full copy remains saved in your database."
msgstr "Показва се само началото. Пълното копие остава запазено в базата ви данни."

