32 \u067e\u0648\u0633\u062a\u0647\u060c \u062e\u0627\u0644\u06cc \u0628\u06af\u0630\u0627\u0631\u06cc\u062f."],"Badge Background":["\u067e\u0633\u200c\u0632\u0645\u06cc\u0646\u0647 \u0646\u0634\u0627\u0646"],"Badge Text":["\u0645\u062a\u0646 \u0646\u0634\u0627\u0646"],"Preview":["\u067e\u06cc\u0634\u200c\u0646\u0645\u0627\u06cc\u0634"],"Supported Themes":["\u067e\u0648\u0633\u062a\u0647\u200c\u0647\u0627\u06cc \u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u06cc\u200c\u0634\u062f\u0647"],"CartPops can integrate with these themes to replace the header cart icon:":["CartPops \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u062f \u0628\u0627 \u0627\u06cc\u0646 \u067e\u0648\u0633\u062a\u0647\u200c\u0647\u0627 \u0627\u062f\u063a\u0627\u0645 \u0634\u0648\u062f \u062a\u0627 \u0622\u06cc\u06a9\u0648\u0646 \u0633\u0628\u062f \u062e\u0631\u06cc\u062f \u062f\u0631 \u0633\u0631\u0628\u0631\u06af \u0631\u0627 \u062c\u0627\u06cc\u06af\u0632\u06cc\u0646 \u06a9\u0646\u062f:"],"More themes coming soon":["\u067e\u0648\u0633\u062a\u0647\u200c\u0647\u0627\u06cc \u0628\u06cc\u0634\u062a\u0631 \u0628\u0647\u200c\u0632\u0648\u062f\u06cc"],"Inline Background":["\u067e\u0633\u200c\u0632\u0645\u06cc\u0646\u0647 \u062f\u0631\u0648\u0646\u200c\u062e\u0637\u06cc"],"Inline Text":["\u0645\u062a\u0646 \u062f\u0631\u0648\u0646\u200c\u062e\u0637\u06cc"],"Inline Badge Background":["\u067e\u0633\u200c\u0632\u0645\u06cc\u0646\u0647 \u0646\u0634\u0627\u0646 \u062f\u0631\u0648\u0646\u200c\u062e\u0637\u06cc"],"Inline Badge Text":["\u0645\u062a\u0646 \u0646\u0634\u0627\u0646 \u062f\u0631\u0648\u0646\u200c\u062e\u0637\u06cc"],"Floating Cart Launcher":["\u062f\u06a9\u0645\u0647 \u0634\u0646\u0627\u0648\u0631 \u0633\u0628\u062f \u062e\u0631\u06cc\u062f"],"Configure the floating cart button that opens the drawer.":["\u067e\u06cc\u06a9\u0631\u0628\u0646\u062f\u06cc \u062f\u06a9\u0645\u0647 \u0634\u0646\u0627\u0648\u0631 \u0633\u0628\u062f \u062e\u0631\u06cc\u062f \u06a9\u0647 \u067e\u0646\u0644 \u06a9\u0634\u0648\u06cc\u06cc \u0631\u0627 \u0628\u0627\u0632 \u0645\u06cc\u200c\u06a9\u0646\u062f."],"Visibility":["\u0646\u0645\u0627\u06cc\u0634"],"Show floating cart launcher":["\u0646\u0645\u0627\u06cc\u0634 \u062f\u06a9\u0645\u0647 \u0634\u0646\u0627\u0648\u0631 \u0633\u0628\u062f \u062e\u0631\u06cc\u062f"],"Display the floating cart button on the frontend.":["\u0646\u0645\u0627\u06cc\u0634 \u062f\u06a9\u0645\u0647 \u0634\u0646\u0627\u0648\u0631 \u0633\u0628\u062f \u062e\u0631\u06cc\u062f \u062f\u0631 \u0633\u0645\u062a \u06a9\u0627\u0631\u0628\u0631."],"Show item count":["\u0646\u0645\u0627\u06cc\u0634 \u062a\u0639\u062f\u0627\u062f \u0622\u06cc\u062a\u0645\u200c\u0647\u0627"],"Show cart total":["\u0646\u0645\u0627\u06cc\u0634 \u0645\u062c\u0645\u0648\u0639 \u0633\u0628\u062f \u062e\u0631\u06cc\u062f"],"Hide zero item count":["\u0645\u062e\u0641\u06cc \u06a9\u0631\u062f\u0646 \u062a\u0639\u062f\u0627\u062f \u062f\u0631 \u0635\u0648\u0631\u062a \u0635\u0641\u0631 \u0628\u0648\u062f\u0646"],"Hide when cart is empty":["\u0645\u062e\u0641\u06cc \u06a9\u0631\u062f\u0646 \u0647\u0646\u06af\u0627\u0645 \u062e\u0627\u0644\u06cc \u0628\u0648\u062f\u0646 \u0633\u0628\u062f \u062e\u0631\u06cc\u062f"],"Screen Position":["\u0645\u0648\u0642\u0639\u06cc\u062a \u062f\u0631 \u0635\u0641\u062d\u0647"],"Bottom Right":["\u067e\u0627\u06cc\u06cc\u0646 \u0631\u0627\u0633\u062a"],"Bottom Left":["\u067e\u0627\u06cc\u06cc\u0646 \u0686\u067e"],"Offset X (px)":["\u0641\u0627\u0635\u0644\u0647 \u0627\u0641\u0642\u06cc (\u067e\u06cc\u06a9\u0633\u0644)"],"Offset Y (px)":["\u0641\u0627\u0635\u0644\u0647 \u0639\u0645\u0648\u062f\u06cc (\u067e\u06cc\u06a9\u0633\u0644)"],"Size (px)":["\u0627\u0646\u062f\u0627\u0632\u0647 (\u067e\u06cc\u06a9\u0633\u0644)"],"Appearance":["\u0638\u0627\u0647\u0631"],"Icon Style":["\u0633\u0628\u06a9 \u0622\u06cc\u06a9\u0648\u0646"],"Shopping Cart":["\u0633\u0628\u062f \u062e\u0631\u06cc\u062f"],"Shopping Bag":["\u06a9\u06cc\u0633\u0647 \u062e\u0631\u06cc\u062f"],"Navigation menu launcher (legacy)":["\u0631\u0627\u0647\u200c\u0627\u0646\u062f\u0627\u0632 \u0645\u0646\u0648\u06cc \u0646\u0627\u0648\u0628\u0631\u06cc (\u0642\u062f\u06cc\u0645\u06cc)"],"These settings affect existing navigation menu items with the cpops-cart-menu-item CSS class. They do not add a menu item.":["\u0627\u06cc\u0646 \u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u0628\u0631 \u0622\u06cc\u062a\u0645\u200c\u0647\u0627\u06cc \u0641\u0639\u0644\u06cc \u0645\u0646\u0648\u06cc \u0646\u0627\u0648\u0628\u0631\u06cc \u0628\u0627 \u06a9\u0644\u0627\u0633 CSS \u0628\u0646\u0627\u0645 cpops-cart-menu-item \u0627\u0639\u0645\u0627\u0644 \u0645\u06cc\u200c\u0634\u0648\u062f. \u0627\u06cc\u0646 \u06af\u0632\u06cc\u0646\u0647 \u0622\u06cc\u062a\u0645 \u062c\u062f\u06cc\u062f\u06cc \u0628\u0647 \u0645\u0646\u0648 \u0627\u0636\u0627\u0641\u0647 \u0646\u0645\u06cc\u200c\u06a9\u0646\u062f."],"Navigation menu icon":["\u0622\u06cc\u06a9\u0648\u0646 \u0645\u0646\u0648\u06cc \u0646\u0627\u0648\u0628\u0631\u06cc"],"Navigation menu item count style":["\u0633\u0628\u06a9 \u0646\u0645\u0627\u06cc\u0634 \u062a\u0639\u062f\u0627\u062f \u0622\u06cc\u062a\u0645 \u062f\u0631 \u0645\u0646\u0648\u06cc \u0646\u0627\u0648\u0628\u0631\u06cc"],"Hide zero item count in navigation menu":["\u0645\u062e\u0641\u06cc \u06a9\u0631\u062f\u0646 \u062a\u0639\u062f\u0627\u062f \u0635\u0641\u0631 \u062f\u0631 \u0645\u0646\u0648\u06cc \u0646\u0627\u0648\u0628\u0631\u06cc"],"Show cart total in navigation menu":["\u0646\u0645\u0627\u06cc\u0634 \u0645\u062c\u0645\u0648\u0639 \u0633\u0628\u062f \u062e\u0631\u06cc\u062f \u062f\u0631 \u0645\u0646\u0648\u06cc \u0646\u0627\u0648\u0628\u0631\u06cc"],"Inline launcher appearance":["\u0638\u0627\u0647\u0631 \u0631\u0627\u0647\u200c\u0627\u0646\u062f\u0627\u0632 \u062f\u0631\u0648\u0646\u200c\u062e\u0637\u06cc"],"These colors apply to navigation menu, shortcode, and inline block launchers. Floating launcher colors remain separate.":["\u0627\u06cc\u0646 \u0631\u0646\u06af\u200c\u0647\u0627 \u0628\u0631 \u0631\u0627\u0647\u200c\u0627\u0646\u062f\u0627\u0632\u0647\u0627\u06cc \u0645\u0646\u0648\u06cc \u0646\u0627\u0648\u0628\u0631\u06cc\u060c \u06a9\u062f \u06a9\u0648\u062a\u0627\u0647 \u0648 \u0628\u0644\u0648\u06a9 \u062f\u0631\u0648\u0646\u200c\u062e\u0637\u06cc \u0627\u0639\u0645\u0627\u0644 \u0645\u06cc\u200c\u0634\u0648\u0646\u062f. \u0631\u0646\u06af\u200c\u0647\u0627\u06cc \u0631\u0627\u0647\u200c\u0627\u0646\u062f\u0627\u0632 \u0634\u0646\u0627\u0648\u0631 \u062c\u062f\u0627\u06af\u0627\u0646\u0647 \u0645\u06cc\u200c\u0645\u0627\u0646\u0646\u062f."],"Launcher previews":["\u067e\u06cc\u0634\u200c\u0646\u0645\u0627\u06cc\u0634\u200c\u0647\u0627\u06cc \u0631\u0627\u0647\u200c\u0627\u0646\u062f\u0627\u0632"],"Product Recommendations":["\u067e\u06cc\u0634\u0646\u0647\u0627\u062f\u0647\u0627\u06cc \u0645\u062d\u0635\u0648\u0644"],"Show relevant product suggestions in the cart drawer to boost average order value.":["\u0646\u0645\u0627\u06cc\u0634 \u067e\u06cc\u0634\u0646\u0647\u0627\u062f\u0647\u0627\u06cc \u0645\u0631\u062a\u0628\u0637 \u0645\u062d\u0635\u0648\u0644 \u062f\u0631 \u067e\u0646\u0644 \u06a9\u0634\u0648\u06cc\u06cc \u0633\u0628\u062f \u062e\u0631\u06cc\u062f \u0628\u0631\u0627\u06cc \u0627\u0641\u0632\u0627\u06cc\u0634 \u0645\u06cc\u0627\u0646\u06af\u06cc\u0646 \u0627\u0631\u0632\u0634 \u0633\u0641\u0627\u0631\u0634."],"Enable Recommendations":["\u0641\u0639\u0627\u0644\u200c\u0633\u0627\u0632\u06cc \u067e\u06cc\u0634\u0646\u0647\u0627\u062f\u0647\u0627"],"Strategy":["\u0627\u0633\u062a\u0631\u0627\u062a\u0698\u06cc"],"How to select which products to recommend.":["\u0646\u062d\u0648\u0647 \u0627\u0646\u062a\u062e\u0627\u0628 \u0645\u062d\u0635\u0648\u0644\u0627\u062a\u06cc \u06a9\u0647 \u0628\u0627\u06cc\u062f \u067e\u06cc\u0634\u0646\u0647\u0627\u062f \u0634\u0648\u0646\u062f."],"Cross-sells":["\u0641\u0631\u0648\u0634 \u0645\u06a9\u0645\u0644"],"Upsells":["\u0628\u06cc\u0634\u200c\u0641\u0631\u0648\u0634\u06cc"],"Custom products (Pro)":["\u0645\u062d\u0635\u0648\u0644\u0627\u062a \u0633\u0641\u0627\u0631\u0634\u06cc (\u067e\u0631\u0648)"],"Choose specific recommendation products with CartPops Pro. Cross-sells and upsells remain available in the Free edition.":["\u0645\u062d\u0635\u0648\u0644\u0627\u062a \u067e\u06cc\u0634\u0646\u0647\u0627\u062f\u06cc \u0645\u0634\u062e\u0635\u06cc \u0631\u0627 \u0628\u0627 CartPops Pro \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0646\u06cc\u062f. \u0641\u0631\u0648\u0634 \u0645\u06a9\u0645\u0644 \u0648 \u0628\u06cc\u0634\u200c\u0641\u0631\u0648\u0634\u06cc \u062f\u0631 \u0646\u0633\u062e\u0647 \u0631\u0627\u06cc\u06af\u0627\u0646 \u0647\u0645\u0686\u0646\u0627\u0646 \u062f\u0631 \u062f\u0633\u062a\u0631\u0633 \u0647\u0633\u062a\u0646\u062f."],"Fallback Strategy":["\u0627\u0633\u062a\u0631\u0627\u062a\u0698\u06cc \u062c\u0627\u06cc\u06af\u0632\u06cc\u0646"],"Used when the primary strategy returns no results.":["\u0632\u0645\u0627\u0646\u06cc \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f \u06a9\u0647 \u0627\u0633\u062a\u0631\u0627\u062a\u0698\u06cc \u0627\u0635\u0644\u06cc \u0647\u06cc\u0686 \u0646\u062a\u06cc\u062c\u0647\u200c\u0627\u06cc \u0646\u062f\u0627\u0634\u062a\u0647 \u0628\u0627\u0634\u062f."],"Random products":["\u0645\u062d\u0635\u0648\u0644\u0627\u062a \u062a\u0635\u0627\u062f\u0641\u06cc"],"Number of products":["\u062a\u0639\u062f\u0627\u062f \u0645\u062d\u0635\u0648\u0644\u0627\u062a"],"Display":["\u0646\u0645\u0627\u06cc\u0634"],"Horizontal Scroll":["\u0627\u0633\u06a9\u0631\u0648\u0644 \u0627\u0641\u0642\u06cc"],"Grid":["\u0634\u0628\u06a9\u0647\u200c\u0627\u06cc"],"List":["\u0641\u0647\u0631\u0633\u062a"],"Heading":["\u0639\u0646\u0648\u0627\u0646"],"Recommendation add buttons use the accessible icon presentation. Text and text-with-icon buttons are available with CartPops Pro.":["\u062f\u06a9\u0645\u0647\u200c\u0647\u0627\u06cc \u0627\u0641\u0632\u0648\u062f\u0646 \u067e\u06cc\u0634\u0646\u0647\u0627\u062f\u0627\u062a \u0627\u0632 \u0646\u0645\u0627\u06cc\u0634 \u0622\u06cc\u06a9\u0648\u0646 \u062f\u0633\u062a\u0631\u0633\u06cc\u200c\u067e\u0630\u06cc\u0631 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0645\u06cc\u200c\u06a9\u0646\u0646\u062f. \u062f\u06a9\u0645\u0647\u200c\u0647\u0627\u06cc \u0645\u062a\u0646\u06cc \u0648 \u0645\u062a\u0646\u06cc \u0647\u0645\u0631\u0627\u0647 \u0628\u0627 \u0622\u06cc\u06a9\u0648\u0646 \u062f\u0631 CartPops Pro \u062f\u0631 \u062f\u0633\u062a\u0631\u0633 \u0647\u0633\u062a\u0646\u062f."],"Explore Pro button styles":["\u0645\u0634\u0627\u0647\u062f\u0647 \u0633\u0628\u06a9\u200c\u0647\u0627\u06cc \u062f\u06a9\u0645\u0647 Pro"]}}}