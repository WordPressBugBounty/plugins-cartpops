e8\u05d9\u05e7 \u05db\u05d3\u05d9 \u05dc\u05d4\u05e9\u05d1\u05d9\u05ea."],"Product successfully added to your cart.":["\u05d4\u05de\u05d5\u05e6\u05e8 \u05e0\u05d5\u05e1\u05e3 \u05d1\u05d4\u05e6\u05dc\u05d7\u05d4 \u05dc\u05e1\u05dc \u05d4\u05e7\u05e0\u05d9\u05d5\u05ea \u05e9\u05dc\u05da."],"Coupon heading":["\u05db\u05d5\u05ea\u05e8\u05ea \u05e7\u05d5\u05e4\u05d5\u05df"],"No heading by default":["\u05dc\u05dc\u05d0 \u05db\u05d5\u05ea\u05e8\u05ea \u05db\u05d1\u05e8\u05d9\u05e8\u05ea \u05de\u05d7\u05d3\u05dc"],"Coupon input placeholder":["\u05de\u05e6\u05d9\u05d9\u05df \u05de\u05d9\u05e7\u05d5\u05dd \u05d1\u05e9\u05d3\u05d4 \u05d4\u05e7\u05d5\u05e4\u05d5\u05df"],"Coupon button text":["\u05d8\u05e7\u05e1\u05d8 \u05db\u05e4\u05ea\u05d5\u05e8 \u05e7\u05d5\u05e4\u05d5\u05df"],"Totals and empty-cart text":["\u05e1\u05d9\u05db\u05d5\u05de\u05d9\u05dd \u05d5\u05d8\u05e7\u05e1\u05d8 \u05e1\u05dc \u05e8\u05d9\u05e7"],"Subtotal label":["\u05ea\u05d5\u05d5\u05d9\u05ea \u05e1\u05db\u05d5\u05dd \u05d1\u05d9\u05e0\u05d9\u05d9\u05dd"],"Discount label":["\u05ea\u05d5\u05d5\u05d9\u05ea \u05d4\u05e0\u05d7\u05d4"],"Total label":["\u05ea\u05d5\u05d5\u05d9\u05ea \u05e1\u05da \u05d4\u05db\u05dc"],"Empty-cart title":["\u05db\u05d5\u05ea\u05e8\u05ea \u05e1\u05dc \u05e8\u05d9\u05e7"],"Empty-cart subtitle":["\u05db\u05d5\u05ea\u05e8\u05ea \u05de\u05e9\u05e0\u05d4 \u05dc\u05e1\u05dc \u05e8\u05d9\u05e7"],"No subtitle by default":["\u05dc\u05dc\u05d0 \u05db\u05d5\u05ea\u05e8\u05ea \u05de\u05e9\u05e0\u05d4 \u05db\u05d1\u05e8\u05d9\u05e8\u05ea \u05de\u05d7\u05d3\u05dc"],"Empty-cart button text":["\u05d8\u05e7\u05e1\u05d8 \u05db\u05e4\u05ea\u05d5\u05e8 \u05e1\u05dc \u05e8\u05d9\u05e7"],"Quantity Selector":["\u05d1\u05d5\u05e8\u05e8 \u05db\u05de\u05d5\u05d9\u05d5\u05ea"],"Style":["\u05e1\u05d2\u05e0\u05d5\u05df"],"Rounded":["\u05de\u05e2\u05d5\u05d2\u05dc"],"Basket":["\u05e1\u05dc\u05e1\u05d9\u05dc\u05d4"],"Cart 2":["\u05e2\u05d2\u05dc\u05d4 2"],"Bag 2":["\u05ea\u05d9\u05e7 2"],"Basket 2":["\u05e1\u05dc\u05e1\u05d9\u05dc\u05d4 2"],"Theme":["\u05e2\u05e8\u05db\u05ea \u05e2\u05d9\u05e6\u05d5\u05d1"],"Integration available":["\u05d0\u05d9\u05e0\u05d8\u05d2\u05e8\u05e6\u05d9\u05d4 \u05d6\u05de\u05d9\u05e0\u05d4"],"No integration available":["\u05d0\u05d9\u05df \u05d0\u05d9\u05e0\u05d8\u05d2\u05e8\u05e6\u05d9\u05d4 \u05d6\u05de\u05d9\u05e0\u05d4"],"Cart Icon":["\u05e1\u05de\u05dc \u05e1\u05dc \u05d4\u05e7\u05e0\u05d9\u05d5\u05ea"],"Replace header cart icon":["\u05d4\u05d7\u05dc\u05e4\u05ea \u05e1\u05de\u05dc \u05d4\u05e1\u05dc \u05d1\u05db\u05d5\u05ea\u05e8\u05ea \u05d4\u05e2\u05dc\u05d9\u05d5\u05e0\u05d4"],"Replace the Blocksy header cart icon with a CartPops icon.":["\u05d4\u05d7\u05dc\u05e4\u05ea \u05e1\u05de\u05dc \u05d4\u05e1\u05dc \u05d1\u05db\u05d5\u05ea\u05e8\u05ea \u05d4\u05e2\u05dc\u05d9\u05d5\u05e0\u05d4 \u05e9\u05dc Blocksy \u05d1\u05e1\u05de\u05dc \u05e9\u05dc CartPops."],"Icon style":["\u05e1\u05d2\u05e0\u05d5\u05df \u05e1\u05de\u05dc"],"Show item count badge":["\u05d4\u05e6\u05d2\u05ea \u05ea\u05d2 \u05de\u05e1\u05e4\u05e8 \u05e4\u05e8\u05d9\u05d8\u05d9\u05dd"],"Display the number of items in the cart on the icon.":["\u05d4\u05e6\u05d2\u05ea \u05de\u05e1\u05e4\u05e8 \u05d4\u05e4\u05e8\u05d9\u05d8\u05d9\u05dd \u05d1\u05e1\u05dc \u05e2\u05dc \u05d2\u05d1\u05d9 \u05d4\u05e1\u05de\u05dc."],"Open CartPops drawer on click":["\u05e4\u05ea\u05d9\u05d7\u05ea \u05de\u05d2\u05d9\u05e8\u05ea CartPops \u05d1\u05dc\u05d7\u05d9\u05e6\u05d4"],"Click the header cart icon to open the CartPops drawer instead of the Blocksy cart panel.":["\u05dc\u05d7\u05d9\u05e6\u05d4 \u05e2\u05dc \u05e1\u05de\u05dc \u05d4\u05e1\u05dc \u05d1\u05db\u05d5\u05ea\u05e8\u05ea \u05ea\u05e4\u05ea\u05d7 \u05d0\u05ea \u05de\u05d2\u05d9\u05e8\u05ea CartPops \u05d1\u05de\u05e7\u05d5\u05dd \u05d0\u05ea \u05dc\u05d5\u05d7 \u05d4\u05e1\u05dc \u05e9\u05dc Blocksy."],"Leave empty to inherit colors from the theme.":["\u05d9\u05e9 \u05dc\u05d4\u05e9\u05d0\u05d9\u05e8 \u05e8\u05d9\u05e7 \u05db\u05d3\u05d9 \u05dc\u05e8\u05e9\u05ea \u05e6\u05d1\u05e2\u05d9\u05dd \u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05e2\u05d9\u05e6\u05d5\u05d1."],"Badge Background":["\u05e8\u05e7\u05e2 \u05d4\u05ea\u05d2"],"Badge Text":["\u05d8\u05e7\u05e1\u05d8 \u05d4\u05ea\u05d2"],"Preview":["\u05ea\u05e6\u05d5\u05d2\u05d4 \u05de\u05e7\u05d3\u05d9\u05de\u05d4"],"Supported Themes":["\u05e2\u05e8\u05db\u05d5\u05ea \u05e2\u05d9\u05e6\u05d5\u05d1 \u05e0\u05ea\u05de\u05db\u05d5\u05ea"],"CartPops can integrate with these themes to replace the header cart icon:":["\u200fCartPops \u05d9\u05db\u05d5\u05dc \u05dc\u05d4\u05e9\u05ea\u05dc\u05d1 \u05e2\u05dd \u05e2\u05e8\u05db\u05d5\u05ea \u05e2\u05d9\u05e6\u05d5\u05d1 \u05d0\u05dc\u05d4 \u05db\u05d3\u05d9 \u05dc\u05d4\u05d7\u05dc\u05d9\u05e3 \u05d0\u05ea \u05e1\u05de\u05dc \u05d4\u05e1\u05dc \u05d1\u05db\u05d5\u05ea\u05e8\u05ea \u05d4\u05e2\u05dc\u05d9\u05d5\u05e0\u05d4:"],"More themes coming soon":["\u05e2\u05e8\u05db\u05d5\u05ea \u05e2\u05d9\u05e6\u05d5\u05d1 \u05e0\u05d5\u05e1\u05e4\u05d5\u05ea \u05d1\u05e7\u05e8\u05d5\u05d1"],"Inline Background":["\u05e8\u05e7\u05e2 \u05de\u05d5\u05d8\u05d1\u05e2"],"Inline Text":["\u05d8\u05e7\u05e1\u05d8 \u05de\u05d5\u05d8\u05de\u05e2"],"Inline Badge Background":["\u05e8\u05e7\u05e2 \u05ea\u05d2\u05d9\u05ea \u05de\u05d5\u05d8\u05de\u05e2\u05ea"],"Inline Badge Text":["\u05d8\u05e7\u05e1\u05d8 \u05ea\u05d2\u05d9\u05ea \u05de\u05d5\u05d8\u05de\u05e2\u05ea"],"Floating Cart Launcher":["\u05db\u05e4\u05ea\u05d5\u05e8 \u05e1\u05dc \u05e6\u05e3"],"Configure the floating cart button that opens the drawer.":["\u05d4\u05d2\u05d3\u05e8\u05ea \u05db\u05e4\u05ea\u05d5\u05e8 \u05e1\u05dc \u05d4\u05e7\u05e0\u05d9\u05d5\u05ea \u05d4\u05e6\u05e3 \u05e9\u05e4\u05d5\u05ea\u05d7 \u05d0\u05ea \u05d4\u05de\u05d2\u05d9\u05e8\u05d4."],"Visibility":["\u05e0\u05e8\u05d0\u05d5\u05ea"],"Show floating cart launcher":["\u05d4\u05e6\u05d2\u05ea \u05db\u05e4\u05ea\u05d5\u05e8 \u05e1\u05dc \u05e6\u05e3"],"Display the floating cart button on the frontend.":["\u05d4\u05e6\u05d2\u05ea \u05db\u05e4\u05ea\u05d5\u05e8 \u05e1\u05dc \u05d4\u05e7\u05e0\u05d9\u05d5\u05ea \u05d4\u05e6\u05e3 \u05d1\u05d7\u05d6\u05d9\u05ea \u05d4\u05d0\u05ea\u05e8."],"Show item count":["\u05d4\u05e6\u05d2\u05ea \u05de\u05e1\u05e4\u05e8 \u05e4\u05e8\u05d9\u05d8\u05d9\u05dd"],"Show cart total":["\u05d4\u05e6\u05d2\u05ea \u05e1\u05d4\u05f4\u05db \u05d1\u05e1\u05dc"],"Hide zero item count":["\u05d4\u05e1\u05ea\u05e8\u05ea \u05de\u05e1\u05e4\u05e8 \u05e4\u05e8\u05d9\u05d8\u05d9\u05dd \u05db\u05d0\u05e9\u05e8 \u05d4\u05d5\u05d0 0"],"Hide when cart is empty":["\u05d4\u05e1\u05ea\u05e8\u05d4 \u05db\u05d0\u05e9\u05e8 \u05d4\u05e1\u05dc \u05e8\u05d9\u05e7"],"Screen Position":["\u05de\u05d9\u05e7\u05d5\u05dd \u05d1\u05de\u05e1\u05da"],"Bottom Right":["\u05dc\u05de\u05d8\u05d4 \u05de\u05d9\u05de\u05d9\u05df"],"Bottom Left":["\u05dc\u05de\u05d8\u05d4 \u05de\u05e9\u05de\u05d0\u05dc"],"Offset X (px)":["\u05d4\u05d9\u05e1\u05d8 X (\u05e4\u05d9\u05e7\u05e1\u05dc\u05d9\u05dd)"],"Offset Y (px)":["\u05d4\u05d9\u05e1\u05d8 Y (\u05e4\u05d9\u05e7\u05e1\u05dc\u05d9\u05dd)"],"Size (px)":["\u05d2\u05d5\u05d3\u05dc (\u05e4\u05d9\u05e7\u05e1\u05dc\u05d9\u05dd)"],"Appearance":["\u05de\u05e8\u05d0\u05d4"],"Icon Style":["\u05e1\u05d2\u05e0\u05d5\u05df \u05d0\u05d9\u05d9\u05e7\u05d5\u05df"],"Shopping Cart":["\u05e2\u05d2\u05dc\u05ea \u05e7\u05e0\u05d9\u05d5\u05ea"],"Shopping Bag":["\u05e9\u05e7\u05d9\u05ea \u05e7\u05e0\u05d9\u05d5\u05ea"],"Navigation menu launcher (legacy)":["\u05de\u05e9\u05d2\u05e8 \u05d1\u05ea\u05e4\u05e8\u05d9\u05d8 \u05d4\u05e0\u05d9\u05d5\u05d5\u05d8 (\u05d9\u05e9\u05df)"],"These settings affect existing navigation menu items with the cpops-cart-menu-item CSS class. They do not add a menu item.":["\u05d4\u05d2\u05d3\u05e8\u05d5\u05ea \u05d0\u05dc\u05d5 \u05de\u05e9\u05e4\u05d9\u05e2\u05d5\u05ea \u05e2\u05dc \u05e4\u05e8\u05d9\u05d8\u05d9\u05dd \u05e7\u05d9\u05d9\u05de\u05d9\u05dd \u05d1\u05ea\u05e4\u05e8\u05d9\u05d8 \u05d4\u05e0\u05d9\u05d5\u05d5\u05d8 \u05e2\u05dd \u05e7\u05dc\u05d0\u05e1 \u05d4-CSS \u05d1\u05e9\u05dd cpops-cart-menu-item. \u05d4\u05df \u05d0\u05d9\u05e0\u05df \u05de\u05d5\u05e1\u05d9\u05e4\u05d5\u05ea \u05e4\u05e8\u05d9\u05d8 \u05dc\u05ea\u05e4\u05e8\u05d9\u05d8."],"Navigation menu icon":["\u05d0\u05d9\u05d9\u05e7\u05d5\u05df \u05d1\u05ea\u05e4\u05e8\u05d9\u05d8 \u05d4\u05e0\u05d9\u05d5\u05d5\u05d8"],"Navigation menu item count style":["\u05e1\u05d2\u05e0\u05d5\u05df \u05de\u05e1\u05e4\u05e8 \u05e4\u05e8\u05d9\u05d8\u05d9\u05dd \u05d1\u05ea\u05e4\u05e8\u05d9\u05d8 \u05d4\u05e0\u05d9\u05d5\u05d5\u05d8"],"Hide zero item count in navigation menu":["\u05d4\u05e1\u05ea\u05e8\u05ea \u05de\u05e1\u05e4\u05e8 \u05e4\u05e8\u05d9\u05d8\u05d9\u05dd \u05db\u05d0\u05e9\u05e8 \u05d4\u05d5\u05d0 0 \u05d1\u05ea\u05e4\u05e8\u05d9\u05d8 \u05d4\u05e0\u05d9\u05d5\u05d5\u05d8"],"Show cart total in navigation menu":["\u05d4\u05e6\u05d2\u05ea \u05e1\u05d4\u05f4\u05db \u05d1\u05e1\u05dc \u05d1\u05ea\u05e4\u05e8\u05d9\u05d8 \u05d4\u05e0\u05d9\u05d5\u05d5\u05d8"],"Inline launcher appearance":["\u05de\u05e8\u05d0\u05d4 \u05de\u05e9\u05d2\u05e8 \u05de\u05d5\u05d8\u05de\u05e2"],"These colors apply to navigation menu, shortcode, and inline block launchers. Floating launcher colors remain separate.":["\u05e6\u05d1\u05e2\u05d9\u05dd \u05d0\u05dc\u05d5 \u05d7\u05dc\u05d9\u05dd \u05e2\u05dc \u05de\u05e9\u05d2\u05e8\u05d9\u05dd \u05d1\u05ea\u05e4\u05e8\u05d9\u05d8 \u05d4\u05e0\u05d9\u05d5\u05d5\u05d8, \u05d1\u05e9\u05d5\u05e8\u05d8\u05e7\u05d5\u05d3 \u05d5\u05d1\u05d1\u05dc\u05d5\u05e7 \u05de\u05d5\u05d8\u05de\u05e2. \u05e6\u05d1\u05e2\u05d9 \u05d4\u05de\u05e9\u05d2\u05e8 \u05d4\u05e6\u05e3 \u05e0\u05e9\u05d0\u05e8\u05d9\u05dd \u05e0\u05e4\u05e8\u05d3\u05d9\u05dd."],"Launcher previews":["\u05ea\u05e6\u05d5\u05d2\u05d4 \u05de\u05e7\u05d3\u05d9\u05de\u05d4 \u05e9\u05dc \u05d4\u05de\u05e9\u05d2\u05e8"],"Product Recommendations":["\u05d4\u05de\u05dc\u05e6\u05d5\u05ea \u05e2\u05dc \u05de\u05d5\u05e6\u05e8\u05d9\u05dd"],"Show relevant product suggestions in the cart drawer to boost average order value.":["\u05d4\u05e6\u05d2\u05ea \u05d4\u05e6\u05e2\u05d5\u05ea \u05dc\u05de\u05d5\u05e6\u05e8\u05d9\u05dd \u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9\u05d9\u05dd \u05d1\u05de\u05d2\u05d9\u05e8\u05ea \u05d4\u05e1\u05dc \u05db\u05d3\u05d9 \u05dc\u05d4\u05d2\u05d3\u05d9\u05dc \u05d0\u05ea \u05e2\u05e8\u05da \u05d4\u05d4\u05d6\u05de\u05e0\u05d4 \u05d4\u05de\u05de\u05d5\u05e6\u05e2."],"Enable Recommendations":["\u05d4\u05e4\u05e2\u05dc\u05ea \u05d4\u05de\u05dc\u05e6\u05d5\u05ea"],"Strategy":["\u05d0\u05e1\u05d8\u05e8\u05d8\u05d2\u05d9\u05d4"],"How to select which products to recommend.":["\u05db\u05d9\u05e6\u05d3 \u05dc\u05d1\u05d7\u05d5\u05e8 \u05d0\u05d9\u05dc\u05d5 \u05de\u05d5\u05e6\u05e8\u05d9\u05dd \u05dc\u05d4\u05de\u05dc\u05d9\u05e5."],"Cross-sells":["\u05de\u05db\u05d9\u05e8\u05d5\u05ea \u05e6\u05d5\u05dc\u05d1\u05d5\u05ea"],"Upsells":["\u05e9\u05d3\u05e8\u05d5\u05d2\u05d9 \u05de\u05d5\u05e6\u05e8\u05d9\u05dd"],"Custom products (Pro)":["\u05de\u05d5\u05e6\u05e8\u05d9\u05dd \u05de\u05d5\u05ea\u05d0\u05de\u05d9\u05dd \u05d0\u05d9\u05e9\u05d9\u05ea (Pro)"],"Choose specific recommendation products with CartPops Pro. Cross-sells and upsells remain available in the Free edition.":["\u05d1\u05d7\u05d9\u05e8\u05ea \u05de\u05d5\u05e6\u05e8\u05d9\u05dd \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05d9\u05dd \u05dc\u05d4\u05de\u05dc\u05e6\u05d4 \u05e2\u05dd CartPops Pro. \u05de\u05db\u05d9\u05e8\u05d5\u05ea \u05e6\u05d5\u05dc\u05d1\u05d5\u05ea \u05d5\u05e9\u05d3\u05e8\u05d5\u05d2\u05d9 \u05de\u05d5\u05e6\u05e8\u05d9\u05dd \u05e0\u05e9\u05d0\u05e8\u05d9\u05dd \u05d6\u05de\u05d9\u05e0\u05d9\u05dd \u05d1\u05d2\u05e8\u05e1\u05d4 \u05d4\u05d7\u05d9\u05e0\u05de\u05d9\u05ea."],"Fallback Strategy":["\u05d0\u05e1\u05d8\u05e8\u05d8\u05d2\u05d9\u05d4 \u05d7\u05dc\u05d5\u05e4\u05d9\u05ea"],"Used when the primary strategy returns no results.":["\u05de\u05e9\u05de\u05e9 \u05db\u05d0\u05e9\u05e8 \u05d4\u05d0\u05e1\u05d8\u05e8\u05d8\u05d2\u05d9\u05d4 \u05d4\u05e8\u05d0\u05e9\u05d9\u05ea \u05d0\u05d9\u05e0\u05d4 \u05de\u05d7\u05d6\u05d9\u05e8\u05d4 \u05ea\u05d5\u05e6\u05d0\u05d5\u05ea."],"Random products":["\u05de\u05d5\u05e6\u05e8\u05d9\u05dd \u05d0\u05e7\u05e8\u05d0\u05d9\u05d9\u05dd"],"Number of products":["\u05de\u05e1\u05e4\u05e8 \u05de\u05d5\u05e6\u05e8\u05d9\u05dd"],"Display":["\u05ea\u05e6\u05d5\u05d2\u05d4"],"Horizontal Scroll":["\u05d2\u05dc\u05d9\u05dc\u05d4 \u05d0\u05d5\u05e4\u05e7\u05d9\u05ea"],"Grid":["\u05e8\u05e9\u05ea"],"List":["\u05e8\u05e9\u05d9\u05de\u05d4"],"Heading":["\u05db\u05d5\u05ea\u05e8\u05ea"],"Recommendation add buttons use the accessible icon presentation. Text and text-with-icon buttons are available with CartPops Pro.":["\u05db\u05e4\u05ea\u05d5\u05e8\u05d9 \u05d4\u05d4\u05d5\u05e1\u05e4\u05d4 \u05e9\u05dc \u05d4\u05d4\u05de\u05dc\u05e6\u05d5\u05ea \u05de\u05e9\u05ea\u05de\u05e9\u05d9\u05dd \u05d1\u05ea\u05e6\u05d5\u05d2\u05ea \u05d0\u05d9\u05d9\u05e7\u05d5\u05df \u05e0\u05d2\u05d9\u05e9\u05d4. \u05db\u05e4\u05ea\u05d5\u05e8\u05d9 \u05d8\u05e7\u05e1\u05d8 \u05d5\u05db\u05e4\u05ea\u05d5\u05e8\u05d9 \u05d8\u05e7\u05e1\u05d8 \u05e2\u05dd \u05d0\u05d9\u05d9\u05e7\u05d5\u05df \u05d6\u05de\u05d9\u05e0\u05d9\u05dd \u05d1-CartPops Pro."],"Explore Pro button styles":["\u05d4\u05db\u05e8 \u05d0\u05ea \u05e1\u05d2\u05e0\u05d5\u05e0\u05d5\u05ea \u05d4\u05db\u05e4\u05ea\u05d5\u05e8\u05d9\u05dd \u05d1-Pro"]}}}