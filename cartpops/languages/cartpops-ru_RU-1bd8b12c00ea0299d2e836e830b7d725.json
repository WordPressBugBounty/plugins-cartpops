2\u043d\u044b\u0445 \u0443\u0440\u043e\u0432\u043d\u044f\u0445 \u043d\u0430\u0433\u0440\u0430\u0434."],"Progress Colors":["\u0426\u0432\u0435\u0442\u0430 \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0430"],"Bar Start":["\u041d\u0430\u0447\u0430\u043b\u043e \u0448\u043a\u0430\u043b\u044b"],"Bar End":["\u041a\u043e\u043d\u0435\u0446 \u0448\u043a\u0430\u043b\u044b"],"Icon Background":["\u0424\u043e\u043d \u0438\u043a\u043e\u043d\u043a\u0438"],"Truck Background":["\u0424\u043e\u043d \u0433\u0440\u0443\u0437\u043e\u0432\u0438\u043a\u0430"],"Truck Icon":["\u0418\u043a\u043e\u043d\u043a\u0430 \u0433\u0440\u0443\u0437\u043e\u0432\u0438\u043a\u0430"],"Tier Reached":["\u0423\u0440\u043e\u0432\u0435\u043d\u044c \u0434\u043e\u0441\u0442\u0438\u0433\u043d\u0443\u0442"],"Tier Icon":["\u0418\u043a\u043e\u043d\u043a\u0430 \u0443\u0440\u043e\u0432\u043d\u044f"],"Qualified Colors":["\u0426\u0432\u0435\u0442\u0430 \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f \u0443\u0441\u043b\u043e\u0432\u0438\u0439"],"Shield (Protection)":["\u0429\u0438\u0442 (\u0437\u0430\u0449\u0438\u0442\u0430)"],"Heart":["\u0421\u0435\u0440\u0434\u0446\u0435"],"Sparkles":["\u0418\u0441\u043a\u0440\u044b"],"Use whole currency units.":["\u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 \u0446\u0435\u043b\u044b\u0435 \u0435\u0434\u0438\u043d\u0438\u0446\u044b \u0432\u0430\u043b\u044e\u0442\u044b."],"Use no more than %d decimal place.":["\u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 \u043d\u0435 \u0431\u043e\u043b\u0435\u0435 %d \u0434\u0435\u0441\u044f\u0442\u0438\u0447\u043d\u043e\u0433\u043e \u0437\u043d\u0430\u043a\u0430.","\u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 \u043d\u0435 \u0431\u043e\u043b\u0435\u0435 %d \u0434\u0435\u0441\u044f\u0442\u0438\u0447\u043d\u044b\u0445 \u0437\u043d\u0430\u043a\u043e\u0432.","\u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 \u043d\u0435 \u0431\u043e\u043b\u0435\u0435 %d \u0434\u0435\u0441\u044f\u0442\u0438\u0447\u043d\u044b\u0445 \u0437\u043d\u0430\u043a\u043e\u0432."],"Enter a positive charge of at least %s.":["\u0412\u0432\u0435\u0434\u0438\u0442\u0435 \u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u0443\u044e \u0441\u0443\u043c\u043c\u0443 \u043d\u0435 \u043c\u0435\u043d\u0435\u0435 %s."],"This draft will not be saved until corrected.":["\u042d\u0442\u043e\u0442 \u0447\u0435\u0440\u043d\u043e\u0432\u0438\u043a \u043d\u0435 \u0431\u0443\u0434\u0435\u0442 \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d \u0434\u043e \u0438\u0441\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u043e\u0448\u0438\u0431\u043e\u043a."],"Configure add-on options that customers can toggle in the cart drawer.":["\u041d\u0430\u0441\u0442\u0440\u043e\u0439\u0442\u0435 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u043e\u043f\u0446\u0438\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043f\u043e\u043a\u0443\u043f\u0430\u0442\u0435\u043b\u0438 \u043c\u043e\u0433\u0443\u0442 \u0432\u043a\u043b\u044e\u0447\u0430\u0442\u044c \u0432 \u0432\u044b\u0434\u0432\u0438\u0436\u043d\u043e\u0439 \u043a\u043e\u0440\u0437\u0438\u043d\u0435."],"Shipping Protection":["\u0417\u0430\u0449\u0438\u0442\u0430 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0438"],"Enable Shipping Protection":["\u0412\u043a\u043b\u044e\u0447\u0438\u0442\u044c \u0437\u0430\u0449\u0438\u0442\u0443 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0438"],"Allow customers to add shipping protection to their order.":["\u0420\u0430\u0437\u0440\u0435\u0448\u0438\u0442\u044c \u043f\u043e\u043a\u0443\u043f\u0430\u0442\u0435\u043b\u044f\u043c \u0434\u043e\u0431\u0430\u0432\u043b\u044f\u0442\u044c \u0437\u0430\u0449\u0438\u0442\u0443 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0438 \u043a \u0441\u0432\u043e\u0435\u043c\u0443 \u0437\u0430\u043a\u0430\u0437\u0443."],"Description":["\u041e\u043f\u0438\u0441\u0430\u043d\u0438\u0435"],"Protect your order from damage or loss":["\u0417\u0430\u0449\u0438\u0442\u0438\u0442\u0435 \u0432\u0430\u0448 \u0437\u0430\u043a\u0430\u0437 \u043e\u0442 \u043f\u043e\u0432\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u044f \u0438\u043b\u0438 \u0443\u0442\u0435\u0440\u0438"],"Price":["\u0426\u0435\u043d\u0430"],"Show Icon":["\u041f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c \u0438\u043a\u043e\u043d\u043a\u0443"],"Display an icon next to the add-on in the cart drawer.":["\u041e\u0442\u043e\u0431\u0440\u0430\u0436\u0430\u0442\u044c \u0438\u043a\u043e\u043d\u043a\u0443 \u0440\u044f\u0434\u043e\u043c \u0441 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u043e\u043f\u0446\u0438\u0435\u0439 \u0432 \u0432\u044b\u0434\u0432\u0438\u0436\u043d\u043e\u0439 \u043a\u043e\u0440\u0437\u0438\u043d\u0435."],"Default State":["\u0421\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u043f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e"],"Whether the add-on is toggled on or off by default for new visitors.":["\u0412\u043a\u043b\u044e\u0447\u0435\u043d\u043e \u0438\u043b\u0438 \u0432\u044b\u043a\u043b\u044e\u0447\u0435\u043d\u043e \u0434\u043e\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u0435 \u043f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e \u0434\u043b\u044f \u043d\u043e\u0432\u044b\u0445 \u043f\u043e\u0441\u0435\u0442\u0438\u0442\u0435\u043b\u0435\u0439."],"Off (customer opts in)":["\u0412\u044b\u043a\u043b\u044e\u0447\u0435\u043d\u043e (\u043f\u043e\u043a\u0443\u043f\u0430\u0442\u0435\u043b\u044c \u0432\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u0441\u0430\u043c)"],"On (customer opts out)":["\u0412\u043a\u043b\u044e\u0447\u0435\u043d\u043e (\u043f\u043e\u043a\u0443\u043f\u0430\u0442\u0435\u043b\u044c \u043c\u043e\u0436\u0435\u0442 \u043e\u0442\u043a\u043b\u044e\u0447\u0438\u0442\u044c)"]}}}