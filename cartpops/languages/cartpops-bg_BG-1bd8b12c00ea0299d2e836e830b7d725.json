"Collapse %s":["\u0421\u0432\u0438\u0432\u0430\u043d\u0435 \u043d\u0430 %s"],"Expand %s":["\u0420\u0430\u0437\u0433\u044a\u0432\u0430\u043d\u0435 \u043d\u0430 %s"],"Move %s up":["\u041f\u0440\u0435\u043c\u0435\u0441\u0442\u0432\u0430\u043d\u0435 \u043d\u0430 %s \u043d\u0430\u0433\u043e\u0440\u0435"],"Move %s down":["\u041f\u0440\u0435\u043c\u0435\u0441\u0442\u0432\u0430\u043d\u0435 \u043d\u0430 %s \u043d\u0430\u0434\u043e\u043b\u0443"],"Always":["\u0412\u0438\u043d\u0430\u0433\u0438"],"Blocks rules below":["\u0411\u043b\u043e\u043a\u0438\u0440\u0430 \u043f\u0440\u0430\u0432\u0438\u043b\u0430\u0442\u0430 \u043e\u0442\u0434\u043e\u043b\u0443"],"Enable":["\u0410\u043a\u0442\u0438\u0432\u0438\u0440\u0430\u043d\u0435"],"Label":["\u0415\u0442\u0438\u043a\u0435\u0442"],"Admin label to identify this rule.":["\u0410\u0434\u043c\u0438\u043d\u0438\u0441\u0442\u0440\u0430\u0442\u043e\u0440\u0441\u043a\u0438 \u0435\u0442\u0438\u043a\u0435\u0442 \u0437\u0430 \u0438\u0434\u0435\u043d\u0442\u0438\u0444\u0438\u0446\u0438\u0440\u0430\u043d\u0435 \u043d\u0430 \u0442\u043e\u0432\u0430 \u043f\u0440\u0430\u0432\u0438\u043b\u043e."],"Mode":["\u0420\u0435\u0436\u0438\u043c"],"Dismissible":["\u0417\u0430\u0442\u0432\u0430\u0440\u044f\u0449\u0430 \u0441\u0435"],"Allow customers to close this bar.":["\u041f\u043e\u0437\u0432\u043e\u043b\u0435\u0442\u0435 \u043d\u0430 \u043a\u043b\u0438\u0435\u043d\u0442\u0438\u0442\u0435 \u0434\u0430 \u0437\u0430\u0442\u0432\u0430\u0440\u044f\u0442 \u0442\u0430\u0437\u0438 \u043b\u0435\u043d\u0442\u0430."],"Duration (minutes)":["\u041f\u0440\u043e\u0434\u044a\u043b\u0436\u0438\u0442\u0435\u043b\u043d\u043e\u0441\u0442 (\u043c\u0438\u043d\u0443\u0442\u0438)"],"Message":["\u0421\u044a\u043e\u0431\u0449\u0435\u043d\u0438\u0435"],"Use {{timer}} as a placeholder for the countdown.":["\u0418\u0437\u043f\u043e\u043b\u0437\u0432\u0430\u0439\u0442\u0435 {{timer}} \u043a\u0430\u0442\u043e \u0437\u0430\u043c\u0435\u0441\u0442\u0438\u0442\u0435\u043b \u0437\u0430 \u043e\